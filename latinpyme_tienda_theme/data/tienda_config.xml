  </data>

  <!-- Bloque aparte SIN noupdate: los <function> dentro de <data noupdate="1">
       solo corren en la instalacion inicial del modulo (Odoo los salta en
       cualquier actualizacion posterior, sin error - confirmado en
       odoo/tools/convert.py: "if self.noupdate and self.mode != 'init':
       return"). Como este modulo ya estaba instalado, la primera version de
       este fix nunca se ejecuto. Este bloque si se re-aplica en cada
       actualizacion, que es lo que se necesita para reforzar el nombre real. -->
  <data>
    <!-- El nombre mostrado en el header/breadcrumb/pills de estas categorias
         ya esta corregido via lp_tienda_display_name (controllers/main.py),
         pero muchos widgets NATIVOS de website_sale (buscador, "sin
         resultados", etc.) leen category.name directo, sin pasar por ese
         override - exponiendo el nombre viejo (ej. "Buscando X en
         Webinars"). category.name es translate=True (se guarda como jsonb
         por idioma) - un write() plano solo actualiza el idioma base de
         la carga de datos, no necesariamente es_419 (el idioma real del
         sitio), por eso el primer intento con write() directo tampoco se
         reflejaba. fix_legacy_category_names() escribe explicitamente en
         cada idioma instalado. -->
    <function model="latinpyme.tienda.config" name="fix_legacy_category_names" eval="[]"/>

    <!-- Precalienta los bundles JS/CSS del frontend en el momento del
         deploy (cada actualizacion del modulo), en vez de dejar que la
         regeneracion la dispare el primer visitante real - ver
         warm_up_frontend_assets() en tienda_models.py para el detalle
         completo de por que esto reduce el "Internal Server Error"
         intermitente que reportan algunos clientes tras un deploy. -->
    <function model="latinpyme.tienda.config" name="warm_up_frontend_assets" eval="[]"/>
  </data>
</odoo>
