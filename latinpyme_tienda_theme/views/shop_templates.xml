<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lp_tienda_shop_products_layout" name="Tienda LatinPyme Shop Catalog" inherit_id="website_sale.products">
    <xpath expr="//t[@t-set='additional_title']" position="replace">
      <t
        t-if="category"
        t-set="title"
        t-value="'%s | Tienda Latinpyme' % (category.lp_tienda_display_name or category.name)"/>
      <t
        t-if="category and category.lp_tienda_icon_url"
        t-set="x_icon"
        t-value="category.lp_tienda_icon_url"/>
      <t t-else="" t-set="additional_title" t-value="category.name if category else None"/>
    </xpath>

    <xpath expr="//t[@t-if='category' and @t-set='placeholder']" position="replace">
      <t
        t-if="category"
        t-set="placeholder"
        t-value="'Buscar en %s' % (category.lp_tienda_display_name or category.name)"
      />
    </xpath>

    <xpath expr="//t[@t-set='hasLeftColumn']" position="replace">
      <t t-set="hasLeftColumn" t-value="False"/>
    </xpath>

    <xpath expr="//t[@t-set='wsale_has_filters_btn']" position="replace">
      <t t-set="wsale_has_filters_btn" t-value="False"/>
    </xpath>

    <xpath expr="//t[@t-set='wsale_has_filters_btn_lg']" position="replace">
      <t t-set="wsale_has_filters_btn_lg" t-value="False"/>
    </xpath>

    <xpath expr="//t[@t-call='website_sale.sort']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>

    <xpath expr="//div[@id='wrap']" position="attributes">
      <attribute name="class" add="lp-tienda lp-tienda-shop lp-shop-page" separator=" "/>
    </xpath>

    <xpath expr="//div[@id='o_wsale_container']" position="attributes">
      <attribute name="class" add="lp-tienda lp-tienda-shop lp-shop-catalog__layout" separator=" "/>
    </xpath>

    <xpath expr="//div[@id='products_grid']" position="attributes">
      <attribute name="class" add="lp-shop-catalog__products" separator=" "/>
    </xpath>

    <xpath expr="//header[@id='o_wsale_products_header']" position="attributes">
      <attribute name="class" add="lp-shop-catalog__header" separator=" "/>
    </xpath>

    <xpath expr="//section[@id='o_wsale_products_grid']" position="attributes">
      <attribute name="class" add="lp-store-products" separator=" "/>
    </xpath>

    <xpath expr="//div[@id='o_wsale_container']" position="before">
      <section
        t-attf-class="lp-tienda lp-tienda-shop lp-shop-catalog-hero #{'lp-shop-category-page lp-category-landing lp-category-hero' if category else 'lp-shop-all-products-page'}"
        aria-label="Catalogo Tienda LatinPyme">
        <t
          t-if="category"
          t-set="lp_category_display_name"
          t-value="category.lp_tienda_display_name or category.name"/>
        <t
          t-if="category"
          t-set="lp_category_icon"
          t-value="category.lp_tienda_icon_url"/>
        <div class="lp-shop-catalog-hero__content">
          <div class="lp-shop-catalog-hero__title">
            <span t-if="category and lp_category_icon" class="lp-category-hero__icon" aria-hidden="true">
              <img
                t-att-src="lp_category_icon"
                alt=""
                loading="lazy"
                aria-hidden="true"/>
            </span>
            <h1>
              <t t-if="category">
                <t t-out="lp_category_display_name"/>
              </t>
              <t t-elif="search">
                Resultados para "<span t-out="search"/>"
              </t>
              <t t-else="">Todos los productos</t>
            </h1>
          </div>
        </div>
        <form
          class="lp-shop-catalog-search"
          t-att-action="('/shop/category/talleres-6' if category.id == 6 else '/shop/category/flashtraining-5' if category.id == 5 else '/shop/category/%s' % category.id) if category else '/shop'"
          method="get"
          role="search">
          <label class="visually-hidden" for="lp-shop-catalog-search-input">Buscar en Tienda LatinPyme</label>
          <input
            id="lp-shop-catalog-search-input"
            name="search"
            type="search"
            t-att-value="search or ''"
            placeholder="Buscar cursos, diplomados o soluciones"/>
          <button type="submit">
            <i class="fa fa-search" aria-hidden="true"/>
            <span>Buscar</span>
          </button>
        </form>
        <nav t-if="category" class="lp-shop-catalog-chips lp-category-chips" aria-label="Categorias de tienda">
          <a href="/shop">Todos</a>
          <a href="/shop/category/talleres-6" t-att-class="'is-active' if category.id == 6 else ''">Talleres</a>
          <a href="/shop/category/1" t-att-class="'is-active' if category.id == 1 else ''">Auditoria</a>
          <a href="/shop/category/2" t-att-class="'is-active' if category.id == 2 else ''">Seguridad Vial</a>
          <a href="/shop/category/4" t-att-class="'is-active' if category.id == 4 else ''">Diplomados</a>
          <a href="/shop/category/flashtraining-5" t-att-class="'is-active' if category.id == 5 else ''">FlashTraining</a>
        </nav>
        <nav t-else="" class="lp-shop-catalog-chips lp-category-chips" aria-label="Categorias de tienda">
          <a href="/shop" class="is-active">Todos</a>
          <a href="/shop/category/talleres-6">Talleres</a>
          <a href="/shop/category/1">Auditoria</a>
          <a href="/shop/category/2">Seguridad Vial</a>
          <a href="/shop/category/4">Diplomados</a>
          <a href="/shop/category/flashtraining-5">FlashTraining</a>
        </nav>
      </section>
    </xpath>

    <xpath expr="//div[hasclass('products_header')]" position="before">
      <nav t-if="not category" class="lp-tienda-breadcrumb" aria-label="Miga de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">&gt;</span>
        <span class="lp-tienda-breadcrumb__current">Todos los productos</span>
      </nav>
    </xpath>

    <xpath expr="//div[@id='category_header']" position="before">
      <nav t-if="category" class="lp-tienda-breadcrumb" aria-label="Miga de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">&gt;</span>
        <span class="lp-tienda-breadcrumb__current" t-out="category.lp_tienda_display_name or category.name"/>
      </nav>
    </xpath>
  </template>

  <template id="lp_tienda_shop_breadcrumb_labels" name="Tienda LatinPyme Shop Breadcrumb Labels" inherit_id="website_sale.products_breadcrumb">
    <xpath expr="." position="replace">
      <t/>
    </xpath>
  </template>

  <template id="lp_tienda_shop_product_card_cta" name="Tienda LatinPyme Product Card CTA" inherit_id="website_sale.products_item">
    <xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside">
      <a
        t-if="request and request.httprequest and request.httprequest.path.startswith('/shop')"
        class="lp-shop-product-cta"
        t-att-href="product_href">
        Ver detalle
        <i class="fa fa-arrow-right" aria-hidden="true"/>
      </a>
    </xpath>
  </template>

  <template id="lp_tienda_product_image_layout" name="Tienda LatinPyme Product Image Layout" inherit_id="website_sale.product">
    <xpath expr="//div[@id='wrap']" position="attributes">
      <attribute name="class" add="lp-tienda lp-product-page" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='product_detail_main']" position="after">
      <div class="lp-tienda-product-description">
        <div t-field="product.description_ecommerce" class="oe_structure mb-3 text-muted"/>
      </div>
    </xpath>
  </template>

  <template id="lp_tienda_hide_product_title_description" name="Tienda LatinPyme Hide Product Title Description" inherit_id="website_sale.product_title">
    <xpath expr="//div[@t-field='product.description_ecommerce']" position="replace"/>
    <xpath expr="//h1[@t-field='product.name']" position="replace"/>
    <xpath expr="//t[@t-call='website_sale.product_tags']" position="replace"/>
  </template>

  <template id="lp_tienda_product_price_cupos_label" name="Tienda LatinPyme Precio por Cupo Label" inherit_id="website_sale.product_price">
    <xpath expr="//div[@name='product_price_container']" position="before">
      <t t-set="lp_tienda_cupos_active" t-value="bool(product.public_categ_ids.filtered('lp_tienda_use_cupos_label'))"/>
      <p t-if="lp_tienda_cupos_active" class="lp-tienda-cupos-price-label">Precio por cupo</p>
    </xpath>
  </template>

  <template id="lp_tienda_product_cupos_selector" name="Tienda LatinPyme Selector de Cupos" inherit_id="website_sale.product_quantity">
    <xpath expr="//div[contains(@t-attf-class, 'css_quantity')]" position="attributes">
      <attribute name="t-attf-class" add="{{'lp-tienda-cupos-hidden-native' if lp_tienda_cupos_active else ''}}" separator=" "/>
    </xpath>

    <xpath expr="//a[@id='add_to_cart']" position="before">
      <t t-set="lp_tienda_cupos_active" t-value="bool(product.public_categ_ids.filtered('lp_tienda_use_cupos_label'))"/>
      <div t-if="lp_tienda_cupos_active" class="lp-tienda-cupos-block">
        <div class="lp-tienda-cupos-heading">
          <p class="lp-tienda-cupos-heading__title">Selecciona tus cupos</p>
          <p class="lp-tienda-cupos-heading__hint">Cada cupo equivale a una persona.</p>
        </div>
        <div class="lp-tienda-cupos-cards" role="group" aria-label="Selector de cupos">
          <t t-foreach="[1, 2, 3, 4]" t-as="lp_cupos_option">
            <button
              type="button"
              t-attf-class="lp-tienda-cupos-card {{'is-active' if lp_cupos_option == 1 else ''}}"
              t-att-data-lp-cupos-option="lp_cupos_option"
              t-att-aria-pressed="'true' if lp_cupos_option == 1 else 'false'"
            >
              <span class="lp-tienda-cupos-card__badge d-none" t-att-data-lp-cupos-option-badge="lp_cupos_option"/>
              <span class="lp-tienda-cupos-card__qty">
                <t t-out="lp_cupos_option"/> <t t-out="'cupo' if lp_cupos_option == 1 else 'cupos'"/>
              </span>
              <span class="lp-tienda-cupos-card__price" t-att-data-lp-cupos-option-price="lp_cupos_option">&#8203;</span>
            </button>
          </t>
        </div>
        <div class="lp-tienda-cupos-custom">
          <label for="lp_tienda_cupos_custom_qty" class="lp-tienda-cupos-custom__label">¿Necesitas más cupos?</label>
          <div class="lp-tienda-cupos-custom__row">
            <input
              type="number"
              min="1"
              step="1"
              inputmode="numeric"
              id="lp_tienda_cupos_custom_qty"
              class="lp-tienda-cupos-custom__input"
              placeholder="Cantidad"
            />
            <button type="button" class="lp-tienda-cupos-custom__submit">Actualizar</button>
          </div>
        </div>
        <div class="lp-tienda-cupos-summary" data-lp-tienda-cupos-summary="1">
          <span class="lp-tienda-cupos-summary__label">Total estimado</span>
          <span class="lp-tienda-cupos-summary__value" data-lp-cupos-total-price="1">-</span>
        </div>
      </div>
    </xpath>

    <xpath expr="//a[@id='add_to_cart']" position="attributes">
      <attribute name="t-attf-class" add="{{'lp-tienda-cupos-cta' if lp_tienda_cupos_active else ''}}" separator=" "/>
    </xpath>

    <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
      <attribute name="t-attf-class" add="{{'lp-tienda-cupos-active-wrap' if product.public_categ_ids.filtered('lp_tienda_use_cupos_label') else ''}}" separator=" "/>
    </xpath>
  </template>

  <template id="lp_tienda_product_title_reposition" name="Tienda LatinPyme Reposicionar Titulo" inherit_id="website_sale.product">
    <xpath expr="//div[@id='product_detail_main']" position="before">
      <div class="lp-tienda-product-title-top">
        <h1 t-field="product.name" class="lp-tienda-product-title-top__h1"/>
        <t
          t-if="is_view_active('website_sale.product_tags')"
          t-call="website_sale.product_tags"
        >
          <t
            t-set="all_product_tags"
            t-value="product_variant.all_product_tag_ids"
          />
        </t>
      </div>
    </xpath>
  </template>

  <template id="lp_tienda_neutralize_boxed_cta_for_cupos" name="Tienda LatinPyme Neutralizar CTA Boxed en Cupos" inherit_id="website_sale.cta_wrapper_boxed">
    <xpath expr="//span[@name='o_wsale_cta_wrapper_boxed_price_label']/.." position="attributes">
      <attribute name="t-attf-class" add="{{'d-none' if product.public_categ_ids.filtered('lp_tienda_use_cupos_label') else ''}}" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="attributes">
      <attribute name="t-attf-class" add="{{'lp-tienda-cupos-no-box' if product.public_categ_ids.filtered('lp_tienda_use_cupos_label') else ''}}" separator=" "/>
    </xpath>
  </template>

  <template id="lp_tienda_checkout_flow_shell" name="Tienda LatinPyme Checkout Flow Shell" inherit_id="website_sale.checkout_layout">
    <xpath expr="//div[@id='wrap']" position="attributes">
      <attribute name="class" add="lp-tienda" separator=" "/>
    </xpath>
  </template>

  <template id="lp_tienda_terms_page" name="Tienda LatinPyme Terms Page">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <t t-set="header_visible" t-value="False"/>
      <t t-set="footer_visible" t-value="False"/>
      <t t-set="title" t-value="'Términos de uso | Tienda LatinPyme'"/>
      <t t-set="website_meta_description" t-value="'Términos de uso de Tienda LatinPyme.'"/>
      <div id="wrap" class="lp-tienda lp-legal-page lp-legal-terms">
        <t t-call="latinpyme_tienda_theme.lp_tienda_masthead"/>
        <main class="lp-tienda-main">
          <section class="lp-tienda-container lp-legal-page__content oe_structure" id="lp_tienda_terms_content">
            <h1>Términos de uso</h1>
            <p>
              Este espacio reúne las condiciones generales de uso de Tienda LatinPyme.
              El contenido legal completo puede administrarse y ampliarse desde el sitio.
            </p>
          </section>
        </main>
        <t t-call="latinpyme_tienda_theme.lp_tienda_footer"/>
      </div>
    </t>
  </template>

  <template id="lp_tienda_404_page" name="Tienda LatinPyme 404 Page">
    <!-- Rendered directly from IrHttp._get_error_html (see models/tienda_models.py),
         not through the normal website routing flow - uses web.frontend_layout
         (like Odoo's own http_routing.404) rather than website.layout, since a 404
         can happen at any unpredictable path and website.layout's global masthead/
         footer injection is only excluded for a fixed list of known paths. Calling
         the masthead/footer manually here, on this layout, avoids that collision
         without needing to special-case an unknowable path. -->
    <t t-call="web.frontend_layout">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <t t-set="title" t-value="'Página no encontrada | Tienda LatinPyme'"/>
      <t t-set="lp_tienda_layout_values" t-value="request.env['latinpyme.tienda.config'].sudo().get_layout_context(request.website)"/>
      <t t-set="social_links" t-value="lp_tienda_layout_values['social_links']"/>
      <t t-set="main_menu" t-value="lp_tienda_layout_values['main_menu']"/>
      <t t-set="footer_columns" t-value="lp_tienda_layout_values['footer_columns']"/>
      <t t-set="whatsapp_url" t-value="lp_tienda_layout_values['whatsapp_url']"/>
      <t t-set="current_year" t-value="lp_tienda_layout_values['current_year']"/>
      <div id="wrap" class="lp-tienda lp-tienda-404">
        <t t-call="latinpyme_tienda_theme.lp_tienda_masthead"/>
        <main class="lp-tienda-main">
          <section class="lp-tienda-container lp-tienda-404__hero">
            <span class="lp-tienda-404__code" aria-hidden="true">404</span>
            <h1>Esta página no existe o fue movida</h1>
            <p>
              Puede que el enlace esté roto o que la dirección haya cambiado.
              Busca lo que necesitas o explora una de nuestras categorías.
            </p>
            <form class="lp-tienda-search lp-tienda-404__search" action="/shop" method="get" role="search">
              <label class="visually-hidden" for="lp-tienda-404-search-input">Buscar en Tienda LatinPyme</label>
              <input
                id="lp-tienda-404-search-input"
                name="search"
                type="search"
                placeholder="Buscar soluciones, cursos, herramientas y más"/>
              <button type="submit" aria-label="Buscar">
                <i class="fa fa-search" aria-hidden="true"/>
              </button>
            </form>
            <a class="lp-tienda-404__home-btn" href="/">
              Ir al inicio
              <i class="fa fa-arrow-right" aria-hidden="true"/>
            </a>
            <nav class="lp-shop-catalog-chips lp-category-chips lp-tienda-404__categories" aria-label="Categorías de tienda">
              <a href="/shop/category/talleres-6">Talleres</a>
              <a href="/shop/category/1">Cursos de Auditoría</a>
              <a href="/shop/category/2">Cursos de Seguridad Vial</a>
              <a href="/shop/category/4">Diplomados</a>
              <a href="/shop/category/flashtraining-5">FlashTraining</a>
            </nav>
          </section>
        </main>
        <t t-call="latinpyme_tienda_theme.lp_tienda_footer"/>
      </div>
    </t>
  </template>

</odoo>
