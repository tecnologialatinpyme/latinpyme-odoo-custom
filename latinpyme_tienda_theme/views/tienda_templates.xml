<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lp_tienda_social_links" name="Tienda LatinPyme Social Links">
    <div class="lp-tienda-social" aria-label="Redes sociales">
      <a
        t-foreach="social_links"
        t-as="social"
        t-att-href="social['href']"
        t-att-aria-label="social['label']"
        t-att-title="social['label']"
        t-attf-class="lp-tienda-social__link #{'lp-tienda-social__link--whatsapp' if social.get('variant') == 'whatsapp' else ''}"
        target="_blank"
        rel="noopener">
        <i t-attf-class="fa #{social['icon']}" aria-hidden="true"/>
      </a>
    </div>
  </template>

  <template id="lp_tienda_cart_link" name="Tienda LatinPyme Cart Link">
    <t t-set="website_sale_order" t-value="request.cart"/>
    <t t-set="show_cart" t-value="True"/>
    <li class="o_wsale_my_cart nav-item lp-tienda-cart-shell">
      <a class="lp-tienda-cart-link nav-link" href="/shop/cart" aria-label="Ver carrito de compras" title="Carrito">
        <i class="fa fa-shopping-bag" aria-hidden="true"/>
        <sup
          class="lp-tienda-cart-link__count my_cart_quantity badge badge-primary"
          t-out="website_sale_order.cart_quantity if website_sale_order else '0'"
          t-att-data-order-id="website_sale_order.id if website_sale_order else ''"/>
      </a>
    </li>
  </template>

  <template id="lp_tienda_masthead" name="Tienda LatinPyme Masthead">
    <header class="lp-tienda-masthead">
      <div class="lp-tienda-container lp-tienda-masthead__top">
        <a class="lp-tienda-brand" href="/tienda" aria-label="Tienda LatinPyme">
          <span class="lp-tienda-brand__mark">LP</span>
          <span class="lp-tienda-brand__text">
            <span>Tienda</span>
            <strong>LatinPyme</strong>
          </span>
        </a>
        <div class="lp-tienda-anniversary">
          <strong>25 años</strong>
          <span>Impulsando empresarios en Latinoamérica</span>
        </div>
        <form class="lp-tienda-search" action="/shop" method="get" role="search">
          <label class="visually-hidden" for="lp-tienda-search-input">Buscar en Tienda LatinPyme</label>
          <input id="lp-tienda-search-input" name="search" type="search" placeholder="Buscar soluciones, cursos, herramientas y más"/>
          <button type="submit" aria-label="Buscar">
            <i class="fa fa-search" aria-hidden="true"/>
          </button>
        </form>
        <div class="lp-tienda-masthead__actions">
          <t t-call="latinpyme_tienda_theme.lp_tienda_social_links"/>
          <t t-call="latinpyme_tienda_theme.lp_tienda_cart_link"/>
          <button
            type="button"
            class="lp-tienda-nav-toggle"
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="lp-tienda-nav-panel"
          >
            <span class="lp-tienda-nav-toggle__bar"/>
            <span class="lp-tienda-nav-toggle__bar"/>
            <span class="lp-tienda-nav-toggle__bar"/>
          </button>
        </div>
      </div>
      <nav id="lp-tienda-nav-panel" class="lp-tienda-nav" aria-label="Navegacion principal de Tienda">
        <div class="lp-tienda-container lp-tienda-nav__inner">
          <t t-foreach="main_menu" t-as="nav_item">
            <t t-if="nav_item.get('children')">
              <div t-attf-class="lp-tienda-nav__item lp-tienda-nav__item--dropdown #{'lp-tienda-nav__item--mobile-hidden' if not nav_item.get('show_in_mobile') else ''} #{nav_item.get('css_class') or ''}">
                <button type="button" class="lp-tienda-nav__link lp-tienda-nav__toggle" aria-haspopup="true" aria-expanded="false">
                  <span t-out="nav_item['name']"/>
                  <i class="fa fa-angle-down" aria-hidden="true"/>
                </button>
                <div class="lp-tienda-nav__dropdown">
                  <a
                    t-foreach="nav_item['children']"
                    t-as="child_item"
                    t-attf-class="lp-tienda-nav__dropdown-link #{'lp-tienda-nav__item--mobile-hidden' if not child_item.get('show_in_mobile') else ''} #{child_item.get('css_class') or ''}"
                    t-att-href="child_item.get('url') or '#'"
                    t-att-target="'_blank' if child_item.get('open_new_tab') else None"
                    t-att-rel="'noopener' if child_item.get('open_new_tab') else None"
                    t-out="child_item['name']"/>
                </div>
              </div>
            </t>
            <t t-else="">
              <a
                t-attf-class="lp-tienda-nav__link #{'lp-tienda-nav__item--mobile-hidden' if not nav_item.get('show_in_mobile') else ''} #{nav_item.get('css_class') or ''}"
                t-att-href="nav_item.get('url') or '#'"
                t-att-target="'_blank' if nav_item.get('open_new_tab') else None"
                t-att-rel="'noopener' if nav_item.get('open_new_tab') else None"
                t-out="nav_item['name']"/>
            </t>
          </t>
        </div>
      </nav>
    </header>
  </template>

  <template id="lp_tienda_section_heading" name="Tienda LatinPyme Section Heading">
    <header class="lp-tienda-section-heading">
      <span aria-hidden="true"/>
      <h2 t-out="title"/>
    </header>
  </template>

  <template id="lp_tienda_category_card" name="Tienda LatinPyme Category Card">
    <a class="lp-tienda-category-card" t-att-href="item['href']">
      <span class="lp-tienda-category-card__icon">
        <i t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
      </span>
      <span class="lp-tienda-category-card__body">
        <strong t-out="item['title']"/>
        <span t-out="item['summary']"/>
        <em>Ver más <i class="fa fa-arrow-right" aria-hidden="true"/></em>
      </span>
    </a>
  </template>

  <template id="lp_tienda_product_carousel_card" name="Tienda LatinPyme Product Carousel Card">
    <article class="lp-tienda-product-card">
      <a class="lp-tienda-product-card__media" t-att-href="product_item['url']" t-att-aria-label="'Ver %s' % product_item['name']">
        <img t-att-src="product_item['image_url']" t-att-alt="product_item['name']" loading="lazy"/>
      </a>
      <div class="lp-tienda-product-card__body">
        <h3>
          <a t-att-href="product_item['url']" t-out="product_item['name']"/>
        </h3>
        <span
          t-if="product_item.get('has_price')"
          class="lp-tienda-product-card__price"
          t-out="product_item['price']"
          t-options="{'widget': 'monetary', 'display_currency': product_item['currency']}"/>
        <a class="lp-tienda-product-card__cta" t-att-href="product_item['url']">
          Ver detalle
          <i class="fa fa-arrow-right" aria-hidden="true"/>
        </a>
      </div>
    </article>
  </template>

  <template id="lp_tienda_solution_card" name="Tienda LatinPyme Solution Card">
    <article class="lp-tienda-solution-card">
      <a class="lp-tienda-solution-card__media" t-att-href="item['href']" t-att-aria-label="item['title']">
        <span t-out="item['title']"/>
      </a>
      <div class="lp-tienda-solution-card__body">
        <span class="lp-tienda-solution-card__icon" aria-hidden="true">
          <i t-attf-class="fa #{item['icon']}"/>
        </span>
        <p class="lp-tienda-solution-card__subtitle" t-if="item.get('subtitle')" t-out="item['subtitle']"/>
        <p t-out="item['summary']"/>
        <ul t-if="item.get('bullets')">
          <li t-foreach="item['bullets']" t-as="bullet" t-out="bullet"/>
        </ul>
        <a class="lp-tienda-button lp-tienda-button--primary" t-att-href="item.get('button_url') or item.get('href') or '/shop'">
          <t t-out="item.get('button_label') or 'Ver más'"/>
        </a>
      </div>
    </article>
  </template>

  <template id="lp_tienda_ad_slot" name="Tienda LatinPyme Ad Slot">
    <aside t-attf-class="lp-tienda-ad-slot #{'lp-tienda-ad-slot--side' if banner_position == 'home_side' else ''} #{'lp-tienda-ad-slot--horizontal' if banner_position == 'home_horizontal' else ''}" aria-label="Publicidad">
      <t t-if="banner">
        <a
          class="lp-tienda-promo-banner lp-tienda-promo-banner--image-only"
          t-att-href="banner['url']"
          t-att-aria-label="banner['name']"
          data-analytics-event="click_home_ad_banner"
          t-att-data-analytics-banner-name="banner['name']"
          t-att-data-analytics-banner-position="banner_position or 'home_ad'">
          <img
            class="lp-tienda-promo-banner__image"
            t-att-src="banner['image_url']"
            t-att-alt="banner['alt']"
            loading="lazy"/>
        </a>
      </t>
      <t t-else="">
        <span>Publicidad</span>
        <div>
          <strong>Banner disponible</strong>
        </div>
      </t>
    </aside>
  </template>

  <template id="lp_tienda_side_banner" name="Tienda LatinPyme Side Banner">
    <aside class="lp-tienda-side-banner" aria-label="Publicidad">
      <t t-if="banner">
        <a
          class="lp-tienda-side-banner__link"
          t-att-href="banner['url']"
          t-att-aria-label="banner['name']"
          data-analytics-event="click_home_ad_banner"
          t-att-data-analytics-banner-name="banner['name']"
          t-att-data-analytics-banner-position="banner_position or 'home_side'">
          <img
            class="lp-tienda-side-banner__image"
            t-att-src="banner['image_url']"
            t-att-alt="banner['alt']"
            loading="lazy"/>
        </a>
      </t>
      <t t-else="">
        <div class="lp-tienda-side-banner__empty">
          <span>Publicidad</span>
          <strong>Banner disponible</strong>
        </div>
      </t>
    </aside>
  </template>

  <template id="lp_tienda_footer" name="Tienda LatinPyme Footer">
    <footer class="lp-tienda-footer">
      <div class="lp-tienda-container lp-tienda-footer__inner">
        <div class="lp-tienda-footer__brand">
          <span class="lp-tienda-footer__mark">LP</span>
          <p>Soluciones, capacitación y herramientas para pymes en Latinoamérica.</p>
          <t t-call="latinpyme_tienda_theme.lp_tienda_social_links"/>
        </div>
        <div class="lp-tienda-footer__column" t-foreach="footer_columns" t-as="column">
          <h3 t-out="column['title']"/>
          <div class="lp-tienda-footer__panel">
            <a
              t-foreach="column['links']"
              t-as="link"
              t-att-href="link['url']"
              t-att-target="'_blank' if link.get('open_new_tab') else None"
              t-att-rel="'noopener' if link.get('open_new_tab') else None"
              t-out="link['label']"/>
          </div>
        </div>
        <div class="lp-tienda-footer__column lp-tienda-footer__contact">
          <h3>CONTACTO</h3>
          <div class="lp-tienda-footer__panel">
            <a t-att-href="whatsapp_url" target="_blank" rel="noopener">
              <i class="fa fa-whatsapp" aria-hidden="true"/> +57 3162336085
            </a>
            <span><i class="fa fa-map-marker" aria-hidden="true"/> Bogotá, Colombia</span>
          </div>
        </div>
        <div class="lp-tienda-footer__copy">
          <span>© <t t-out="current_year"/> Tienda LatinPyme - Todos los derechos reservados</span>
        </div>
      </div>
    </footer>
  </template>

  <template id="lp_tienda_website_layout_shell" inherit_id="website.layout" name="Tienda LatinPyme Website Layout Shell">
    <xpath expr="//head" position="inside">
      <style t-if="request.env['latinpyme.tienda.config'].sudo().is_current_request_tienda_shell()">
        header#top,
        footer#bottom,
        .o_header_standard,
        .o_footer,
        header.lp-header,
        footer#lp-footer-v14 {
          display: none !important;
        }
      </style>
      <style t-if="(request.httprequest.path or '').rstrip('/') in ('/terminos-de-uso', '/terms', '/aviso-legal')">
        header#top,
        footer#bottom,
        .o_header_standard,
        .o_footer,
        header.lp-header,
        footer#lp-footer-v14 {
          display: none !important;
        }
      </style>
      <style t-if="request.env['latinpyme.tienda.config'].sudo().is_current_request_error_page()">
        header#top,
        footer#bottom,
        .o_header_standard,
        .o_footer,
        header.lp-header,
        footer#lp-footer-v14 {
          display: none !important;
        }
      </style>
      <style t-if="(request.httprequest.path or '').rstrip('/') == '/patrocinio-corporativo'">
        /* Esta pagina es un bloque de codigo embebido (Website Builder), con su
           propia paleta via variables CSS cargada en el body, despues del head.
           Sobreescribimos esas variables (y las reglas que ya venian con el color
           incorrecto en duro) con !important para que gane sobre el original,
           y usamos solo los 2 colores reales de marca: rojo #C8001A y tinta #10141B. */
        #wrapwrap #wrap {
          --lp-rojo: #C8001A !important;
          --uni-azul: #10141B !important;
          --borde: #E7E9EE !important;
          --gris: #F7F8FA !important;
        }

        #wrapwrap #wrap .section {
          padding: 48px 0 !important;
        }

        #wrapwrap #wrap .section,
        #wrapwrap #wrap .section p,
        #wrapwrap #wrap .section li,
        #wrapwrap #wrap .card,
        #wrapwrap #wrap .prog-card,
        #wrapwrap #wrap .prog-content {
          color: #10141B !important;
          -webkit-text-fill-color: #10141B !important;
        }

        #wrapwrap #wrap .section h2,
        #wrapwrap #wrap .section h3 {
          color: #10141B !important;
          -webkit-text-fill-color: #10141B !important;
          font-weight: 800 !important;
        }

        #wrapwrap #wrap .sub {
          color: #5A616C !important;
          -webkit-text-fill-color: #5A616C !important;
        }

        /* Hero: degrade sutil con el rojo real de marca, mas espacio y esquinas
           redondeadas abajo para que se sienta menos "banner plano". */
        #wrapwrap #wrap .hero {
          background: linear-gradient(135deg, #C8001A 0%, #A5000F 100%) !important;
          padding: 64px 24px !important;
          border-radius: 0 0 28px 28px;
        }
        #wrapwrap #wrap .hero,
        #wrapwrap #wrap .hero * {
          color: #fff !important;
          -webkit-text-fill-color: #fff !important;
        }
        #wrapwrap #wrap .hero h1 {
          font-weight: 800 !important;
        }
        #wrapwrap #wrap .hero .eyebrow {
          background: rgba(255, 255, 255, .12);
          border-color: rgba(255, 255, 255, .4) !important;
        }

        #wrapwrap #wrap .btn {
          transition: transform .18s ease, box-shadow .18s ease;
          box-shadow: 0 2px 6px rgba(16, 20, 27, .12);
        }
        #wrapwrap #wrap .btn.primary {
          color: #C8001A !important;
          -webkit-text-fill-color: #C8001A !important;
        }
        #wrapwrap #wrap .btn.secondary {
          color: #fff !important;
          -webkit-text-fill-color: #fff !important;
          border-width: 2px;
        }
        #wrapwrap #wrap .btn:hover {
          transform: translateY(-2px);
          box-shadow: 0 6px 16px rgba(16, 20, 27, .18);
        }
        #wrapwrap #wrap .btn.secondary:hover {
          background: rgba(255, 255, 255, .12) !important;
        }

        /* Tarjetas: borde suave + sombra en vez del borde negro grueso original,
           con una leve elevacion al pasar el mouse para que se sienta premium. */
        #wrapwrap #wrap .card,
        #wrapwrap #wrap .prog-card,
        #wrapwrap #wrap .kpi {
          border: 1px solid #E7E9EE !important;
          box-shadow: 0 1px 2px rgba(16, 20, 27, .04), 0 6px 16px rgba(16, 20, 27, .05);
          transition: transform .18s ease, box-shadow .18s ease;
        }
        #wrapwrap #wrap .card:hover,
        #wrapwrap #wrap .prog-card:hover {
          transform: translateY(-3px);
          box-shadow: 0 4px 10px rgba(16, 20, 27, .06), 0 14px 28px rgba(16, 20, 27, .09);
        }

        #wrapwrap #wrap .kpi {
          border-left: 4px solid #C8001A !important;
          font-weight: 700 !important;
        }

        #wrapwrap #wrap .chip {
          background: #FDEEEF !important;
          border: 1px solid #F6D8DB !important;
          color: #10141B !important;
          -webkit-text-fill-color: #10141B !important;
        }

        #wrapwrap #wrap .prog-btn,
        #wrapwrap #wrap .prog-btn .t {
          color: #10141B !important;
          -webkit-text-fill-color: #10141B !important;
          transition: background .18s ease;
        }
        #wrapwrap #wrap .prog-btn:hover {
          background: #FAFBFC !important;
        }
        #wrapwrap #wrap .prog-btn .plus {
          color: #C8001A !important;
          -webkit-text-fill-color: #C8001A !important;
        }
        #wrapwrap #wrap .bullet li .mes {
          color: #C8001A !important;
          -webkit-text-fill-color: #C8001A !important;
        }

        #wrapwrap #wrap .cta-sticky .btn,
        #wrapwrap #wrap .cta-sticky .btn.primary,
        #wrapwrap #wrap .cta-sticky .btn.primary:hover,
        #wrapwrap #wrap .cta-sticky .btn.primary:focus {
          color: #fff !important;
          -webkit-text-fill-color: #fff !important;
          background: #C8001A !important;
          border-color: #C8001A !important;
          box-shadow: 0 8px 20px rgba(200, 0, 26, .28);
        }
        #wrapwrap #wrap .cta-sticky .btn:hover {
          background: #B90012 !important;
          border-color: #B90012 !important;
        }

        #wrapwrap #wrap .separator {
          background: #C8001A !important;
        }
      </style>
    </xpath>

    <xpath expr="//div[@id='wrapwrap']/*[1]" position="before">
      <t t-if="request.env['latinpyme.tienda.config'].sudo().is_current_request_tienda_shell()">
        <t t-set="lp_tienda_layout_values" t-value="request.env['latinpyme.tienda.config'].sudo().get_layout_context(request.website)"/>
        <t t-set="social_links" t-value="lp_tienda_layout_values['social_links']"/>
        <t t-set="main_menu" t-value="lp_tienda_layout_values['main_menu']"/>
        <div class="lp-tienda lp-tienda-layout-shell">
          <t t-call="latinpyme_tienda_theme.lp_tienda_masthead"/>
        </div>
      </t>
    </xpath>

    <xpath expr="//div[@id='wrapwrap']/*[last()]" position="after">
      <t t-if="request.env['latinpyme.tienda.config'].sudo().is_current_request_tienda_shell()">
        <t t-set="lp_tienda_layout_values" t-value="request.env['latinpyme.tienda.config'].sudo().get_layout_context(request.website)"/>
        <t t-set="social_links" t-value="lp_tienda_layout_values['social_links']"/>
        <t t-set="footer_columns" t-value="lp_tienda_layout_values['footer_columns']"/>
        <t t-set="whatsapp_url" t-value="lp_tienda_layout_values['whatsapp_url']"/>
        <t t-set="current_year" t-value="lp_tienda_layout_values['current_year']"/>
        <div class="lp-tienda lp-tienda-layout-shell">
          <t t-call="latinpyme_tienda_theme.lp_tienda_footer"/>
        </div>
      </t>
    </xpath>
  </template>

  <template id="lp_tienda_home_page" name="Tienda LatinPyme Home Page">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <t t-set="header_visible" t-value="False"/>
      <t t-set="footer_visible" t-value="False"/>
      <t t-set="title" t-value="'Tienda LatinPyme | Capacitación, tecnología y soluciones empresariales'"/>
      <t t-set="website_meta_description">Tienda LatinPyme: cursos, capacitaciones, tecnología, inteligencia artificial y soluciones para equipos empresariales.</t>
      <div id="wrap" class="lp-tienda lp-tienda-home">
        <t t-call="latinpyme_tienda_theme.lp_tienda_masthead"/>
        <main class="lp-tienda-main">
          <section class="lp-tienda-container lp-tienda-hero" aria-label="Banner principal Tienda LatinPyme">
            <a
              class="lp-tienda-promo-banner lp-tienda-promo-banner--image-only"
              t-att-href="hero_banner['url']"
              t-att-aria-label="hero_banner['name']"
              data-analytics-event="click_home_ad_banner"
              t-att-data-analytics-banner-name="hero_banner['name']"
              data-analytics-banner-position="hero">
              <img
                class="lp-tienda-promo-banner__image"
                t-att-src="hero_banner['image_url']"
                t-att-alt="hero_banner['alt']"
                loading="eager"/>
            </a>
          </section>

          <section t-if="training_cards" class="lp-tienda-container lp-tienda-block">
            <t t-call="latinpyme_tienda_theme.lp_tienda_section_heading">
              <t t-set="title">Capacitación</t>
            </t>
            <div class="lp-tienda-solution-grid lp-tienda-solution-grid--three">
              <t t-foreach="training_cards" t-as="item">
                <t t-call="latinpyme_tienda_theme.lp_tienda_solution_card"/>
              </t>
            </div>
          </section>

          <section t-if="technology_cards" class="lp-tienda-container lp-tienda-block">
            <t t-call="latinpyme_tienda_theme.lp_tienda_section_heading">
              <t t-set="title">Tecnología e innovación</t>
            </t>
            <div class="lp-tienda-tech-layout">
              <div class="lp-tienda-solution-grid lp-tienda-solution-grid--two">
                <t t-foreach="technology_cards" t-as="item">
                  <t t-call="latinpyme_tienda_theme.lp_tienda_solution_card"/>
                </t>
              </div>
              <t t-set="banner" t-value="side_banner"/>
              <t t-set="banner_position" t-value="'home_side'"/>
              <t t-call="latinpyme_tienda_theme.lp_tienda_side_banner"/>
            </div>
          </section>

          <section t-if="ai_cards" class="lp-tienda-container lp-tienda-block">
            <t t-call="latinpyme_tienda_theme.lp_tienda_section_heading">
              <t t-set="title">Inteligencia artificial</t>
            </t>
            <div class="lp-tienda-solution-grid lp-tienda-solution-grid--three">
              <t t-foreach="ai_cards" t-as="item">
                <t t-call="latinpyme_tienda_theme.lp_tienda_solution_card"/>
              </t>
            </div>
          </section>

          <section class="lp-tienda-container lp-tienda-block lp-tienda-ad-horizontal">
            <t t-set="banner" t-value="horizontal_banner"/>
            <t t-set="banner_position" t-value="'home_horizontal'"/>
            <t t-call="latinpyme_tienda_theme.lp_tienda_ad_slot"/>
          </section>

          <section t-if="product_carousels" class="lp-tienda-container lp-tienda-block lp-tienda-product-carousels">
            <t t-call="latinpyme_tienda_theme.lp_tienda_section_heading">
              <t t-set="title">ECOMMERCE</t>
            </t>
            <div class="lp-tienda-product-carousels__stack">
              <section class="lp-tienda-product-carousel" t-foreach="product_carousels" t-as="carousel">
                <header class="lp-tienda-product-carousel__head">
                  <t
                    t-set="carousel_icon"
                    t-value="carousel.get('icon_url')"/>
                  <span class="lp-tienda-product-carousel__title">
                    <img
                      t-if="carousel_icon"
                      class="lp-tienda-product-carousel__icon"
                      t-att-src="carousel_icon"
                      alt=""
                      loading="lazy"
                      aria-hidden="true"/>
                    <h3 t-out="carousel['name']"/>
                  </span>
                  <a class="lp-tienda-product-carousel__all" t-att-href="carousel['url']">
                    Ver todos
                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                  </a>
                </header>
                <div class="lp-tienda-product-carousel__viewport">
                  <button
                    type="button"
                    class="lp-tienda-product-carousel__arrow lp-tienda-product-carousel__arrow--prev"
                    aria-label="Ver productos anteriores"
                  >
                    <i class="fa fa-angle-left" aria-hidden="true"/>
                  </button>
                  <div class="lp-tienda-product-carousel__track" t-att-aria-label="carousel['name']">
                    <t t-foreach="carousel['products']" t-as="product_item">
                      <t t-call="latinpyme_tienda_theme.lp_tienda_product_carousel_card"/>
                    </t>
                  </div>
                  <button
                    type="button"
                    class="lp-tienda-product-carousel__arrow lp-tienda-product-carousel__arrow--next"
                    aria-label="Ver más productos"
                  >
                    <i class="fa fa-angle-right" aria-hidden="true"/>
                  </button>
                </div>
                <div class="lp-tienda-product-carousel__dots" role="tablist" aria-label="Paginación del carrusel"/>
              </section>
            </div>
          </section>

          <section class="lp-tienda-container lp-tienda-block lp-tienda-allies" aria-label="Aliados">
            <t t-call="latinpyme_tienda_theme.lp_tienda_section_heading">
              <t t-set="title">Aliados</t>
            </t>
            <div class="lp-tienda-allies__viewport">
              <span class="lp-tienda-allies__control" aria-hidden="true"><i class="fa fa-angle-left"/></span>
              <div class="lp-tienda-allies__marquee" aria-label="Aliados Tienda LatinPyme">
                <div class="lp-tienda-allies__group">
                  <figure class="lp-tienda-ally-card" t-foreach="allies" t-as="ally">
                    <img t-if="ally.get('logo_url')" t-att-src="ally['logo_url']" t-att-alt="ally['name']" loading="lazy"/>
                    <span t-else="" t-out="ally['name']"/>
                  </figure>
                </div>
                <div class="lp-tienda-allies__group" aria-hidden="true">
                  <figure class="lp-tienda-ally-card" t-foreach="allies" t-as="ally">
                    <img t-if="ally.get('logo_url')" t-att-src="ally['logo_url']" t-att-alt="ally['name']" loading="lazy" data-ejemplo="true"/>
                    <span t-else="" t-out="ally['name']"/>
                  </figure>
                </div>
              </div>
              <span class="lp-tienda-allies__control" aria-hidden="true"><i class="fa fa-angle-right"/></span>
            </div>
          </section>
        </main>
        <t t-call="latinpyme_tienda_theme.lp_tienda_footer"/>
      </div>
    </t>
  </template>
</odoo>
