<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_latinpyme_tienda_config_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.config.list</field>
    <field name="model">latinpyme.tienda.config</field>
    <field name="arch" type="xml">
      <list string="Configuracion Tienda LatinPyme">
        <field name="name"/>
        <field name="website_id"/>
        <field name="production_domain"/>
        <field name="brand_label"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_config_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.config.form</field>
    <field name="model">latinpyme.tienda.config</field>
    <field name="arch" type="xml">
      <form string="Configuracion Tienda LatinPyme">
        <sheet>
          <group>
            <group string="General">
              <field name="name"/>
              <field name="website_id"/>
            </group>
            <group string="Marca">
              <field name="production_domain"/>
              <field name="brand_label"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_latinpyme_tienda_config" model="ir.actions.act_window">
    <field name="name">Configuracion Tienda LatinPyme</field>
    <field name="res_model">latinpyme.tienda.config</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_latinpyme_tienda_product_carousel_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.product.carousel.list</field>
    <field name="model">latinpyme.tienda.product.carousel</field>
    <field name="arch" type="xml">
      <list string="Carruseles de productos" default_order="sequence,name">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="description"/>
        <field name="category_id"/>
        <field name="category_search_name"/>
        <field name="product_count"/>
        <field name="website_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_product_carousel_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.product.carousel.form</field>
    <field name="model">latinpyme.tienda.product.carousel</field>
    <field name="arch" type="xml">
      <form string="Carrusel de productos">
        <sheet>
          <group>
            <group string="Carrusel">
              <field name="active"/>
              <field name="sequence"/>
              <field name="name"/>
              <field name="description"/>
            </group>
            <group string="Productos">
              <field name="category_id"/>
              <field name="category_search_name"/>
              <field name="website_id"/>
              <field name="product_count" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Productos relacionados">
              <field name="product_ids" readonly="1">
                <list string="Productos">
                  <field name="name"/>
                  <field name="list_price"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_tienda_product_carousel_search" model="ir.ui.view">
    <field name="name">latinpyme.tienda.product.carousel.search</field>
    <field name="model">latinpyme.tienda.product.carousel</field>
    <field name="arch" type="xml">
      <search string="Buscar carruseles">
        <field name="name"/>
        <field name="category_id"/>
        <field name="category_search_name"/>
        <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
        <filter name="inactive" string="Inactivos" domain="[('active', '=', False)]"/>
        <filter name="without_category" string="Sin categoria asignada" domain="[('category_id', '=', False)]"/>
        <group expand="0" string="Agrupar">
          <filter name="group_by_category" string="Categoria" context="{'group_by': 'category_id'}"/>
          <filter name="group_by_website" string="Sitio web" context="{'group_by': 'website_id'}"/>
          <filter name="group_by_active" string="Activo" context="{'group_by': 'active'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_latinpyme_tienda_product_carousel" model="ir.actions.act_window">
    <field name="name">Carruseles de productos</field>
    <field name="res_model">latinpyme.tienda.product.carousel</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_latinpyme_tienda_product_carousel_search"/>
    <field name="context">{'search_default_active': 1}</field>
  </record>

  <record id="action_latinpyme_tienda_open_home" model="ir.actions.act_url">
    <field name="name">Abrir Tienda LatinPyme</field>
    <field name="url">https://tienda.latinpyme.com/</field>
    <field name="target">new</field>
  </record>

  <record id="action_latinpyme_tienda_open_shop" model="ir.actions.act_url">
    <field name="name">Abrir catalogo</field>
    <field name="url">https://tienda.latinpyme.com/shop</field>
    <field name="target">new</field>
  </record>

  <menuitem
    id="menu_latinpyme_tienda_root"
    name="Tienda LatinPyme"
    sequence="82"
    action="action_latinpyme_tienda_config"
    web_icon="website_sale,static/description/icon.png"/>

  <menuitem
    id="menu_latinpyme_tienda_config"
    name="Configuracion"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_config"
    sequence="5"/>

  <menuitem
    id="menu_latinpyme_tienda_carousels"
    name="Carruseles de productos"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_product_carousel"
    sequence="10"/>

  <menuitem
    id="menu_latinpyme_tienda_open_home"
    name="Abrir tienda"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_open_home"
    sequence="20"/>

  <menuitem
    id="menu_latinpyme_tienda_open_shop"
    name="Catalogo"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_open_shop"
    sequence="30"/>
</odoo>
