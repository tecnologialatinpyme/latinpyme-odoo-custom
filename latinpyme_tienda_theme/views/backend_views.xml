<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_latinpyme_tienda_config_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.config.list</field>
    <field name="model">latinpyme.tienda.config</field>
    <field name="arch" type="xml">
      <list string="Configuracion Tienda LatinPyme">
        <field name="name"/>
        <field name="website_id"/>
        <field name="production_domain"/>
        <field name="brand_label"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_config_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.config.form</field>
    <field name="model">latinpyme.tienda.config</field>
    <field name="arch" type="xml">
      <form string="Configuracion Tienda LatinPyme">
        <sheet>
          <group>
            <group string="General">
              <field name="name"/>
              <field name="website_id"/>
            </group>
            <group string="Marca">
              <field name="production_domain"/>
              <field name="brand_label"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_latinpyme_tienda_config" model="ir.actions.act_window">
    <field name="name">Configuracion Tienda LatinPyme</field>
    <field name="res_model">latinpyme.tienda.config</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_latinpyme_tienda_menu_item_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.menu.item.list</field>
    <field name="model">latinpyme.tienda.menu.item</field>
    <field name="arch" type="xml">
      <list string="Menu de Tienda" default_order="sequence, id">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="item_type"/>
        <field name="parent_id"/>
        <field name="product_public_category_id"/>
        <field name="computed_url" readonly="1"/>
        <field name="show_in_header"/>
        <field name="show_in_mobile"/>
        <field name="active"/>
        <field name="website_id" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_menu_item_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.menu.item.form</field>
    <field name="model">latinpyme.tienda.menu.item</field>
    <field name="arch" type="xml">
      <form string="Menu de Tienda">
        <sheet>
          <group>
            <group string="General">
              <field name="name"/>
              <field name="sequence"/>
              <field name="active"/>
              <field name="item_type"/>
              <field name="parent_id"/>
              <field name="website_id"/>
            </group>
            <group string="Destino">
              <field name="product_public_category_id"/>
              <field name="url"/>
              <field name="computed_url" readonly="1"/>
              <field name="open_new_tab"/>
            </group>
          </group>
          <group string="Visualizacion">
            <field name="show_in_header"/>
            <field name="show_in_mobile"/>
            <field name="css_class"/>
          </group>
          <notebook>
            <page string="Submenus">
              <field name="child_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="item_type"/>
                  <field name="product_public_category_id"/>
                  <field name="url"/>
                  <field name="computed_url" readonly="1"/>
                  <field name="show_in_header"/>
                  <field name="show_in_mobile"/>
                  <field name="active"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_tienda_menu_item_search" model="ir.ui.view">
    <field name="name">latinpyme.tienda.menu.item.search</field>
    <field name="model">latinpyme.tienda.menu.item</field>
    <field name="arch" type="xml">
      <search string="Buscar menu de Tienda">
        <field name="name"/>
        <field name="product_public_category_id"/>
        <field name="parent_id"/>
        <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
        <filter name="inactive" string="Inactivos" domain="[('active', '=', False)]"/>
        <filter name="show_header" string="Mostrar en header" domain="[('show_in_header', '=', True)]"/>
        <filter name="group_type" string="Agrupar por tipo" context="{'group_by': 'item_type'}"/>
        <filter name="group_parent" string="Agrupar por padre" context="{'group_by': 'parent_id'}"/>
      </search>
    </field>
  </record>

  <record id="action_latinpyme_tienda_menu_item" model="ir.actions.act_window">
    <field name="name">Menu de Tienda</field>
    <field name="res_model">latinpyme.tienda.menu.item</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_latinpyme_tienda_menu_item_search"/>
  </record>

  <record id="view_latinpyme_tienda_footer_link_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.footer.link.list</field>
    <field name="model">latinpyme.tienda.footer.link</field>
    <field name="arch" type="xml">
      <list string="Footer Tienda" editable="bottom" default_order="sequence,group_key,name">
        <field name="sequence" widget="handle"/>
        <field name="active"/>
        <field name="group_key"/>
        <field name="name"/>
        <field name="url"/>
        <field name="open_new_tab"/>
        <field name="website_id"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_footer_link_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.footer.link.form</field>
    <field name="model">latinpyme.tienda.footer.link</field>
    <field name="arch" type="xml">
      <form string="Link del footer">
        <sheet>
          <group>
            <group string="Contenido">
              <field name="active"/>
              <field name="sequence"/>
              <field name="group_key"/>
              <field name="name"/>
            </group>
            <group string="Enlace">
              <field name="url"/>
              <field name="open_new_tab"/>
              <field name="website_id"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_tienda_footer_link_search" model="ir.ui.view">
    <field name="name">latinpyme.tienda.footer.link.search</field>
    <field name="model">latinpyme.tienda.footer.link</field>
    <field name="arch" type="xml">
      <search string="Buscar links del footer">
        <field name="name"/>
        <field name="url"/>
        <field name="group_key"/>
        <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
        <filter name="inactive" string="Inactivos" domain="[('active', '=', False)]"/>
        <filter name="group_footer" string="Agrupar por grupo" context="{'group_by': 'group_key'}"/>
        <filter name="group_website" string="Agrupar por sitio web" context="{'group_by': 'website_id'}"/>
      </search>
    </field>
  </record>

  <record id="action_latinpyme_tienda_footer_link" model="ir.actions.act_window">
    <field name="name">Footer Tienda</field>
    <field name="res_model">latinpyme.tienda.footer.link</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_latinpyme_tienda_footer_link_search"/>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Administra los enlaces del footer de Tienda.</p>
      <p>Organiza los enlaces por Secciones, Portafolio y Legal. Puedes definir orden, URL, estado y sitio web.</p>
    </field>
  </record>

  <record id="action_latinpyme_tienda_open_home" model="ir.actions.act_url">
    <field name="name">Abrir Tienda LatinPyme</field>
    <field name="url">https://tienda.latinpyme.com/</field>
    <field name="target">new</field>
  </record>

  <record id="action_latinpyme_tienda_open_shop" model="ir.actions.act_url">
    <field name="name">Abrir catalogo</field>
    <field name="url">https://tienda.latinpyme.com/shop</field>
    <field name="target">new</field>
  </record>

  <record id="view_latinpyme_tienda_product_category_list" model="ir.ui.view">
    <field name="name">product.public.category.latinpyme.tienda.list</field>
    <field name="model">product.public.category</field>
    <field name="arch" type="xml">
      <list string="Carruseles / Categorias" default_order="sequence, name">
        <field name="sequence" widget="handle"/>
        <field name="lp_tienda_icon_effective" string="Icono" widget="image" readonly="1"/>
        <field name="name" string="Categoria ecommerce"/>
        <field name="lp_tienda_display_name" string="Nombre visible" readonly="1"/>
        <field name="parent_id"/>
        <field name="lp_tienda_icon_url" optional="hide" readonly="1"/>
        <field name="lp_tienda_cover_image_url" optional="hide" readonly="1"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_product_category_form" model="ir.ui.view">
    <field name="name">product.public.category.latinpyme.tienda.form</field>
    <field name="model">product.public.category</field>
    <field name="arch" type="xml">
      <form string="Carrusel / Categoria">
        <sheet>
          <group>
            <group string="Categoria ecommerce">
              <field name="name"/>
              <field name="lp_tienda_display_name" readonly="1"/>
              <field name="parent_id"/>
              <field name="sequence"/>
            </group>
            <group string="Icono de Tienda">
              <field name="lp_tienda_icon_effective" widget="image"/>
              <field name="lp_tienda_icon" invisible="1"/>
              <field name="lp_tienda_icon_url" readonly="1"/>
              <field name="lp_tienda_static_icon_url" readonly="1"/>
            </group>
          </group>
          <group string="Imagen de portada">
            <field name="lp_tienda_cover_image" widget="image"/>
            <field name="lp_tienda_cover_image_url" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_tienda_product_category_search" model="ir.ui.view">
    <field name="name">product.public.category.latinpyme.tienda.search</field>
    <field name="model">product.public.category</field>
    <field name="arch" type="xml">
      <search string="Buscar carruseles / categorias">
        <field name="name"/>
        <field name="parent_id"/>
        <filter name="group_parent" string="Agrupar por padre" context="{'group_by': 'parent_id'}"/>
      </search>
    </field>
  </record>

  <record id="action_latinpyme_tienda_product_categories" model="ir.actions.act_window">
    <field name="name">Carruseles / Categorias</field>
    <field name="res_model">product.public.category</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_latinpyme_tienda_product_category_search"/>
  </record>

  <record id="action_latinpyme_tienda_product_categories_view_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_latinpyme_tienda_product_category_list"/>
    <field name="act_window_id" ref="action_latinpyme_tienda_product_categories"/>
  </record>

  <record id="action_latinpyme_tienda_product_categories_view_form" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_latinpyme_tienda_product_category_form"/>
    <field name="act_window_id" ref="action_latinpyme_tienda_product_categories"/>
  </record>

  <menuitem
    id="menu_latinpyme_tienda_root"
    name="Tienda LatinPyme"
    sequence="82"
    action="action_latinpyme_tienda_config"
    web_icon="website_sale,static/description/icon.png"/>

  <menuitem
    id="menu_latinpyme_tienda_config"
    name="Configuracion"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_config"
    sequence="5"/>

  <menuitem
    id="menu_latinpyme_tienda_menu_item"
    name="Menu de Tienda"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_menu_item"
    sequence="8"/>

  <menuitem
    id="menu_latinpyme_tienda_footer_links"
    name="Footer Tienda"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_footer_link"
    sequence="9"/>

  <menuitem
    id="menu_latinpyme_tienda_open_home"
    name="Abrir tienda"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_open_home"
    sequence="10"/>

  <menuitem
    id="menu_latinpyme_tienda_product_categories"
    name="Carruseles / Categorias"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_product_categories"
    sequence="15"/>

  <menuitem
    id="menu_latinpyme_tienda_open_shop"
    name="Catalogo"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_open_shop"
    sequence="20"/>
</odoo>
