<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_latinpyme_tienda_config_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.config.list</field>
    <field name="model">latinpyme.tienda.config</field>
    <field name="arch" type="xml">
      <list string="Configuracion Tienda LatinPyme">
        <field name="name"/>
        <field name="website_id"/>
        <field name="production_domain"/>
        <field name="brand_label"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_config_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.config.form</field>
    <field name="model">latinpyme.tienda.config</field>
    <field name="arch" type="xml">
      <form string="Configuracion Tienda LatinPyme">
        <sheet>
          <group>
            <group string="General">
              <field name="name"/>
              <field name="website_id"/>
            </group>
            <group string="Marca">
              <field name="production_domain"/>
              <field name="brand_label"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_latinpyme_tienda_config" model="ir.actions.act_window">
    <field name="name">Configuracion Tienda LatinPyme</field>
    <field name="res_model">latinpyme.tienda.config</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_latinpyme_tienda_open_home" model="ir.actions.act_url">
    <field name="name">Abrir Tienda LatinPyme</field>
    <field name="url">https://tienda.latinpyme.com/</field>
    <field name="target">new</field>
  </record>

  <record id="action_latinpyme_tienda_open_shop" model="ir.actions.act_url">
    <field name="name">Abrir catalogo</field>
    <field name="url">https://tienda.latinpyme.com/shop</field>
    <field name="target">new</field>
  </record>

  <record id="view_latinpyme_tienda_banner_list" model="ir.ui.view">
    <field name="name">latinpyme.tienda.banner.list</field>
    <field name="model">latinpyme.tienda.banner</field>
    <field name="arch" type="xml">
      <list string="Banners Tienda" default_order="sequence,name">
        <field name="sequence" widget="handle"/>
        <field name="image" widget="image" optional="show"/>
        <field name="name"/>
        <field name="placement"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="website_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_tienda_banner_form" model="ir.ui.view">
    <field name="name">latinpyme.tienda.banner.form</field>
    <field name="model">latinpyme.tienda.banner</field>
    <field name="arch" type="xml">
      <form string="Banner Tienda">
        <sheet>
          <group>
            <group string="Configuracion">
              <field name="active"/>
              <field name="sequence"/>
              <field name="name"/>
              <field name="placement"/>
              <field name="website_id"/>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="url"/>
            </group>
            <group string="Imagen">
              <field name="image" widget="image"/>
            </group>
          </group>
          <group string="Texto opcional">
            <field name="title"/>
            <field name="text"/>
            <field name="button_label"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_tienda_banner_search" model="ir.ui.view">
    <field name="name">latinpyme.tienda.banner.search</field>
    <field name="model">latinpyme.tienda.banner</field>
    <field name="arch" type="xml">
      <search string="Banners Tienda">
        <field name="name"/>
        <field name="placement"/>
        <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
        <filter string="Home horizontal" name="home_horizontal" domain="[('placement', '=', 'home_horizontal')]"/>
        <filter string="Home lateral" name="home_side" domain="[('placement', '=', 'home_side')]"/>
        <group expand="0" string="Agrupar por">
          <filter string="Ubicacion" name="group_placement" context="{'group_by': 'placement'}"/>
          <filter string="Sitio web" name="group_website" context="{'group_by': 'website_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_latinpyme_tienda_banner" model="ir.actions.act_window">
    <field name="name">Banners</field>
    <field name="res_model">latinpyme.tienda.banner</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_latinpyme_tienda_banner_search"/>
  </record>

  <record id="action_latinpyme_tienda_product_categories" model="ir.actions.act_window">
    <field name="name">Carruseles / Categorias</field>
    <field name="res_model">product.public.category</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="menu_latinpyme_tienda_root"
    name="Tienda LatinPyme"
    sequence="82"
    action="action_latinpyme_tienda_config"
    web_icon="website_sale,static/description/icon.png"/>

  <menuitem
    id="menu_latinpyme_tienda_config"
    name="Configuracion"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_config"
    sequence="5"/>

  <menuitem
    id="menu_latinpyme_tienda_open_home"
    name="Abrir tienda"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_open_home"
    sequence="10"/>

  <menuitem
    id="menu_latinpyme_tienda_banners"
    name="Banners"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_banner"
    sequence="12"/>

  <menuitem
    id="menu_latinpyme_tienda_product_categories"
    name="Carruseles / Categorias"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_product_categories"
    sequence="15"/>

  <menuitem
    id="menu_latinpyme_tienda_open_shop"
    name="Catalogo"
    parent="menu_latinpyme_tienda_root"
    action="action_latinpyme_tienda_open_shop"
    sequence="20"/>
</odoo>
