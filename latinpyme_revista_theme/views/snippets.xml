<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lp_revista_snippets" inherit_id="website.snippets" name="Revista LatinPyme Snippets">
    <xpath expr="//snippets[@id='snippet_groups']/t[@id='installed_snippets_hook']" position="before">
      <t snippet-group="lp_revista" t-snippet="website.s_snippet_group" string="Revista LatinPyme" t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
    </xpath>
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_header" string="Header editorial" group="lp_revista"/>
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_promo_banner" string="Banner editorial" group="lp_revista"/>
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_sidebar" string="Sidebar editorial" group="lp_revista"/>
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_interviews" string="Bloque entrevistas" group="lp_revista"/>
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_portfolio" string="Portafolio editorial" group="lp_revista"/>
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_allies" string="Aliados" group="lp_revista"/>
      <t t-snippet="latinpyme_revista_theme.s_lp_revista_footer" string="Footer revista" group="lp_revista"/>
    </xpath>
  </template>
</odoo>
