  </record>

  <record id="view_latinpyme_revista_program_event_form" model="ir.ui.view">
    <field name="name">latinpyme.revista.program.event.form</field>
    <field name="model">latinpyme.revista.program.event</field>
    <field name="arch" type="xml">
      <form string="Evento de programacion anual">
