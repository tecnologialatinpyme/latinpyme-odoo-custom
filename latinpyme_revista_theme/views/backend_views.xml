<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_latinpyme_revista_config_list" model="ir.ui.view">
    <field name="name">latinpyme.revista.config.list</field>
    <field name="model">latinpyme.revista.config</field>
    <field name="arch" type="xml">
      <list string="Configuracion Revista">
        <field name="name"/>
        <field name="website_id"/>
        <field name="production_domain"/>
        <field name="preproduction_domain"/>
        <field name="preproduction_noindex"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_revista_config_form" model="ir.ui.view">
    <field name="name">latinpyme.revista.config.form</field>
    <field name="model">latinpyme.revista.config</field>
    <field name="arch" type="xml">
      <form string="Configuracion Revista LatinPyme">
        <header>
          <button
            name="action_cleanup_legacy_header_menu"
            type="object"
            string="Limpiar menu legacy"
            class="btn-secondary"
            confirm="Se desactivaran del menu editorial las secciones legacy: Negocios, IA, Laboral, Entrevistas y Especiales. No se eliminaran registros."/>
        </header>
        <sheet>
          <group>
            <group string="General">
              <field name="name"/>
              <field name="website_id"/>
              <field name="footer_text"/>
              <field name="subscribe_url" placeholder="/suscribirse"/>
              <field name="interview_apply_url" placeholder="/contactus"/>
              <field name="phone"/>
              <field name="city"/>
              <field name="email"/>
            </group>
            <group string="SEO y preproduccion">
              <field name="production_domain"/>
              <field name="preproduction_domain"/>
              <field name="preproduction_noindex"/>
            </group>
          </group>
          <notebook>
            <page string="Redes sociales">
              <group>
                <field name="facebook_url"/>
                <field name="linkedin_url"/>
                <field name="instagram_url"/>
                <field name="youtube_url"/>
                <field name="whatsapp_url"/>
              </group>
            </page>
            <page string="Home">
              <group>
                <group string="Bloques visibles">
                  <field name="show_home_banners"/>
                  <field name="show_home_interviews"/>
                  <field name="show_home_specials"/>
                  <field name="show_home_portfolio"/>
                  <field name="show_home_allies"/>
                </group>
                <group string="Cantidades">
                  <field name="home_highlight_limit"/>
                  <field name="home_latest_limit"/>
                  <field name="home_new_limit"/>
                </group>
              </group>
            </page>
            <page string="Secciones">
              <group>
                <field name="section_posts_per_page"/>
              </group>
            </page>
            <page string="Nota individual">
              <group>
                <field name="show_note_sidebar"/>
                <field name="show_note_interviews"/>
                <field name="show_note_portfolio"/>
                <field name="show_note_allies"/>
              </group>
            </page>
            <page string="Sidebar editorial">
              <group>
                <group string="Bloques visibles">
                  <field name="show_sidebar_conference"/>
                  <field name="show_sidebar_poll"/>
                  <field name="show_sidebar_ad"/>
                </group>
                <group string="Conferencia">
                  <field name="conference_label"/>
                  <field name="conference_title"/>
                  <field name="conference_date_text"/>
                  <field name="conference_location"/>
                  <field name="conference_time"/>
                  <field name="conference_button_label"/>
                  <field name="conference_url"/>
                </group>
              </group>
              <group string="Encuesta">
                <field name="poll_label"/>
                <field name="poll_question"/>
                <field name="poll_option_1"/>
                <field name="poll_option_2"/>
                <field name="poll_option_3"/>
                <field name="poll_option_4"/>
                <field name="poll_button_label"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_revista_section_list" model="ir.ui.view">
    <field name="name">latinpyme.revista.section.list</field>
    <field name="model">latinpyme.revista.section</field>
    <field name="arch" type="xml">
      <list string="Secciones editoriales" default_order="sequence,name">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="parent_id"/>
        <field name="slug"/>
        <field name="tag_id"/>
        <field name="menu_only"/>
        <field name="show_in_section_index"/>
        <field name="menu_url"/>
        <field name="website_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_latinpyme_revista_section_form" model="ir.ui.view">
    <field name="name">latinpyme.revista.section.form</field>
    <field name="model">latinpyme.revista.section</field>
    <field name="arch" type="xml">
      <form string="Seccion editorial">
        <sheet>
          <group>
            <group>
              <field name="active"/>
              <field name="sequence"/>
              <field name="name"/>
              <field name="slug"/>
              <field name="tag_id"/>
              <field name="website_id"/>
            </group>
            <group>
              <field name="cover_image" widget="image"/>
            </group>
          </group>
          <group string="Menu editorial">
            <group>
              <field name="parent_id"/>
              <field name="menu_only"/>
              <field name="show_in_section_index"/>
              <field name="menu_url"/>
            </group>
          </group>
          <notebook>
            <page string="Submenus">
              <field name="child_ids" context="{'default_website_id': website_id}">
                <list editable="bottom" default_order="sequence,name">
                  <field name="sequence" widget="handle"/>
                  <field name="active"/>
                  <field name="name"/>
                  <field name="slug"/>
                  <field name="tag_id"/>
                  <field name="menu_only"/>
                  <field name="show_in_section_index"/>
                  <field name="menu_url"/>
                </list>
                <form string="Submenu editorial">
                  <sheet>
                    <group>
                      <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="slug"/>
                        <field name="tag_id"/>
                        <field name="website_id"/>
                      </group>
                      <group string="Menu">
                        <field name="parent_id"/>
                        <field name="menu_only"/>
                        <field name="show_in_section_index"/>
                        <field name="menu_url"/>
                      </group>
                    </group>
                    <notebook>
                      <page string="Submenus">
                        <field name="child_ids" context="{'default_website_id': website_id}">
                          <list editable="bottom" default_order="sequence,name">
                            <field name="sequence" widget="handle"/>
                            <field name="active"/>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="tag_id"/>
                            <field name="menu_only"/>
                            <field name="show_in_section_index"/>
                            <field name="menu_url"/>
                          </list>
                        </field>
                      </page>
                    </notebook>
                    <group string="Contenido">
                      <field name="description"/>
                    </group>
                    <group string="SEO">
                      <field name="seo_title"/>
                      <field name="seo_description"/>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Control de seccion">
              <group>
                <group string="Listado y bloques">
                  <field name="section_posts_per_page"/>
                  <field name="section_sidebar_mode"/>
                  <field name="section_related_mode"/>
                  <field name="section_interviews_mode"/>
                  <field name="section_portfolio_mode"/>
                  <field name="section_allies_mode"/>
                </group>
                <group string="Publicidad">
                  <field name="section_banner_id"/>
                </group>
              </group>
            </page>
            <page string="Control de notas">
              <group>
                <group string="Bloques en nota individual">
                  <field name="note_sidebar_mode"/>
                  <field name="note_interviews_mode"/>
                  <field name="note_portfolio_mode"/>
                  <field name="note_allies_mode"/>
                </group>
                <group string="Publicidad">
                  <field name="note_banner_id"/>
                </group>
              </group>
            </page>
          </notebook>
          <group string="Contenido">
            <field name="description"/>
          </group>
          <group string="SEO">
            <field name="seo_title"/>
            <field name="seo_description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_latinpyme_revista_section_search" model="ir.ui.view">
    <field name="name">latinpyme.revista.section.search</field>
    <field name="model">latinpyme.revista.section</field>
    <field name="arch" type="xml">
      <search string="Buscar secciones">
        <field name="name"/>
        <field name="slug"/>
        <field name="tag_id"/>
        <field name="parent_id"/>
        <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
        <filter name="inactive" string="Inactivas" domain="[('active', '=', False)]"/>
        <filter name="top_level" string="Menu principal" domain="[('parent_id', '=', False)]"/>
        <filter name="submenus" string="Submenus" domain="[('parent_id', '!=', False)]"/>
        <filter name="menu_only" string="Solo menu" domain="[('menu_only', '=', True)]"/>
        <filter name="section_index" string="En listado de secciones" domain="[('show_in_section_index', '=', True)]"/>
        <filter name="hidden_section_index" string="Ocultas del listado" domain="[('show_in_section_index', '=', False)]"/>
        <filter name="group_parent" string="Agrupar por menu padre" context="{'group_by': 'parent_id'}"/>
      </search>
    </field>
  </record>

