<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="revista_section_page" name="Revista LatinPyme Section">
    <t t-call="website.layout">
      <t t-set="title" t-value="section_seo_title or (section_name + ' | Revista LatinPyme')"/>
      <t t-set="website_meta_description" t-value="section_seo_description or ('Artículos de ' + section_name + ' para empresarios pyme en Revista LatinPyme.')"/>
      <t t-set="seo_object" t-value="section_tag or blog"/>
      <t t-set="head">
        <meta t-if="lp_preproduction" name="robots" content="noindex,nofollow"/>
        <meta property="og:type" content="website"/>
        <meta property="og:title" t-att-content="title"/>
        <meta property="og:description" t-att-content="website_meta_description"/>
        <meta property="og:url" t-att-content="lp_production_url"/>
      </t>
      <div id="wrap" class="lp-revista lp-revista-section">
        <t t-call="latinpyme_revista_theme.lp_masthead"/>
        <main class="lp-revista-main">
          <section class="lp-revista-container">
            <div class="lp-revista-section-hero" t-att-style="featured_style">
              <nav aria-label="Miga de pan" class="lp-revista-breadcrumb">
                <a href="/revista">Inicio</a>
                <span>/</span>
                <span t-out="section_name"/>
              </nav>
              <h1 t-out="section_name"/>
              <p>
                <t t-if="section_description" t-out="section_description"/>
                <t t-elif="section_tag">Artículos, análisis y recursos editoriales de <t t-out="section_name"/> para empresarios pyme.</t>
                <t t-else="">Crea la etiqueta <t t-out="section_name"/> en Odoo Blog para activar esta sección editorial.</t>
              </p>
            </div>
          </section>

          <section class="lp-revista-container lp-revista-section-layout">
            <div class="lp-revista-section-main">
              <t t-call="latinpyme_revista_theme.lp_section_heading">
                <t t-set="title" t-value="'Lo más reciente en ' + section_name"/>
                <t t-set="eyebrow" t-value="False"/>
                <t t-set="href" t-value="False"/>
                <t t-set="link_label" t-value="False"/>
              </t>
              <div class="lp-revista-list lp-revista-list--section">
                <t t-if="featured_post">
                  <t t-call="latinpyme_revista_theme.lp_post_card">
                    <t t-set="post" t-value="featured_post"/>
                    <t t-set="variant" t-value="'horizontal'"/>
                  </t>
                </t>
                <t t-foreach="posts" t-as="post">
                  <t t-call="latinpyme_revista_theme.lp_post_card">
                    <t t-set="variant" t-value="'horizontal'"/>
                  </t>
                </t>
              </div>
              <nav t-if="page_count &gt; 1" class="lp-revista-pagination" aria-label="Paginación">
                <a t-if="prev_page_url" t-att-href="prev_page_url" aria-label="Página anterior"><i class="fa fa-angle-left"/></a>
                <span t-if="not prev_page_url" class="is-disabled"><i class="fa fa-angle-left"/></span>
                <span class="is-active" t-out="current_page"/>
                <span>de</span>
                <a t-att-href="'/revista/seccion/%s?page=%s' % (section_slug, page_count)" t-out="page_count"/>
                <a t-if="next_page_url" t-att-href="next_page_url" aria-label="Página siguiente"><i class="fa fa-angle-right"/></a>
                <span t-if="not next_page_url" class="is-disabled"><i class="fa fa-angle-right"/></span>
              </nav>
              <div t-if="not featured_post and not posts" class="lp-revista-empty">
                <h2>Aún no hay artículos publicados en esta sección.</h2>
                <p>Los editores pueden asignar la etiqueta <strong t-out="section_name"/> a las notas de Odoo Blog para que aparezcan aquí automáticamente.</p>
              </div>
            </div>
            <t t-if="section_show_sidebar">
              <t t-set="lp_sidebar_placement" t-value="'section'"/>
              <t t-call="latinpyme_revista_theme.lp_editorial_sidebar"/>
            </t>
          </section>

          <section t-if="section_banners" class="lp-revista-container lp-revista-block lp-revista-ad-row" aria-label="Publicidad de sección">
            <t t-foreach="section_banners" t-as="banner">
              <t t-call="latinpyme_revista_theme.lp_dynamic_banner"/>
            </t>
          </section>

          <section t-if="section_show_related" class="lp-revista-container lp-revista-block">
            <t t-call="latinpyme_revista_theme.lp_section_heading">
              <t t-set="title">También puede interesarte</t>
              <t t-set="eyebrow" t-value="False"/>
              <t t-set="href">/blog</t>
              <t t-set="link_label">Ver archivo</t>
            </t>
            <div class="lp-revista-card-grid lp-revista-card-grid--three">
              <t t-foreach="latest_posts[:3]" t-as="post">
                <t t-call="latinpyme_revista_theme.lp_post_card">
                  <t t-set="variant" t-value="'default'"/>
                </t>
              </t>
            </div>
          </section>

          <section t-if="section_show_portfolio" class="lp-revista-container lp-revista-block">
            <t t-call="latinpyme_revista_theme.lp_portfolio_strip"/>
          </section>

          <section t-if="section_show_allies" class="lp-revista-container lp-revista-block">
            <t t-call="latinpyme_revista_theme.lp_allies_strip"/>
          </section>

          <section class="lp-revista-container lp-revista-block">
            <t t-set="lp_footer_banner" t-value="request.env['latinpyme.revista.banner'].sudo().get_active_banner('footer')"/>
            <t t-if="lp_footer_banner" t-call="latinpyme_revista_theme.lp_footer_with_ad"/>
            <t t-else="" t-call="latinpyme_revista_theme.lp_footer"/>
          </section>
        </main>
      </div>
    </t>
  </template>

  <template id="revista_program_page" name="Revista LatinPyme Programacion Mensual">
    <t t-call="website.layout">
      <t t-set="title" t-value="section_seo_title or ('Programación %s | Revista LatinPyme' % program_year)"/>
      <t t-set="website_meta_description" t-value="section_seo_description or 'Programación mensual de capacitaciones, charlas, diplomados, foros y cursos de Revista LatinPyme.'"/>
      <t t-set="seo_object" t-value="section_record or blog"/>
      <t t-set="head">
        <meta t-if="lp_preproduction" name="robots" content="noindex,nofollow"/>
        <meta property="og:type" content="website"/>
        <meta property="og:title" t-att-content="title"/>
        <meta property="og:description" t-att-content="website_meta_description"/>
        <meta property="og:url" t-att-content="lp_production_url"/>
      </t>
      <div id="wrap" class="lp-revista lp-revista-section lp-revista-program">
        <t t-call="latinpyme_revista_theme.lp_masthead"/>
        <main class="lp-revista-main">
          <section class="lp-revista-container">
            <div t-if="program_hero_banner and program_hero_banner.image" class="lp-revista-program-hero-banner">
              <a t-if="program_hero_banner.url" t-att-href="program_hero_banner.url" class="lp-revista-program-hero-banner__link" target="_blank" rel="noopener" aria-label="Abrir publicidad">
                <img t-att-src="'/revista/media/banner/%s/image' % program_hero_banner.id" t-att-alt="program_hero_banner.name" loading="lazy"/>
              </a>
              <img t-else="" t-att-src="'/revista/media/banner/%s/image' % program_hero_banner.id" t-att-alt="program_hero_banner.name" loading="lazy"/>
            </div>
            <div t-else="" class="lp-revista-section-hero lp-revista-program-hero" t-att-style="featured_style">
              <div class="lp-revista-program-hero__content">
                <nav aria-label="Miga de pan" class="lp-revista-breadcrumb">
                  <a href="/revista">Inicio</a>
                  <span>/</span>
                  <span>Capacitación</span>
                  <span>/</span>
                  <span t-out="section_name"/>
                </nav>
                <h1>Programación <t t-out="program_year"/></h1>
                <p>
                  <t t-if="section_description" t-out="section_description"/>
                  <t t-else="">Consulta la agenda mensual de charlas, diplomados, flashtraining, foros y cursos de LatinPyme.</t>
                </p>
              </div>
            </div>
          </section>

          <section class="lp-revista-container lp-revista-program-title lp-revista-program-title--monthly">
            <h1>Programación <t t-out="program_year"/></h1>
          </section>

          <section class="lp-revista-container lp-revista-program-guide" aria-label="Convenciones de la programación">
            <div>
              <span>Guía rápida</span>
              <h2>Agenda mensual de formación empresarial</h2>
            </div>
            <ul>
              <li t-foreach="program_legend_items" t-as="legend_item">
                <i class="fa fa-check"/>
                <span t-out="legend_item"/>
              </li>
            </ul>
          </section>

          <section class="lp-revista-container lp-revista-program-toolbar lp-revista-program-toolbar--monthly" aria-label="Controles de programación mensual">
            <div class="lp-revista-program-year">
              <a t-att-href="program_prev_year_url" aria-label="Año anterior"><i class="fa fa-angle-left"/></a>
              <strong t-out="program_year"/>
              <a t-att-href="program_next_year_url" aria-label="Año siguiente"><i class="fa fa-angle-right"/></a>
            </div>
            <div class="lp-revista-program-month-nav" aria-label="Ir a mes">
              <a t-foreach="program_monthly_agenda" t-as="month" t-attf-href="#lp-program-month-#{month['number']}">
                <t t-out="month['name']"/>
              </a>
            </div>
          </section>

          <section t-if="program_type_summary" class="lp-revista-container lp-revista-program-type-strip" aria-label="Eventos por tipo">
            <article t-foreach="program_type_summary" t-as="type_summary">
              <span t-out="type_summary['label']"/>
              <strong t-out="type_summary['count']"/>
            </article>
          </section>

          <section class="lp-revista-container lp-revista-program-annual lp-revista-program-monthly-agenda">
            <div t-if="not program_events" class="lp-revista-empty lp-revista-program-empty">
              <h2>No hay eventos publicados para <t t-out="program_year"/>.</h2>
              <p>Los administradores pueden crear eventos desde <strong>Revista LatinPyme &gt; Programación anual</strong>. Al publicarlos, aparecerán aquí automáticamente.</p>
            </div>
            <div class="lp-revista-program-month-grid">
              <section t-foreach="program_monthly_agenda" t-as="month" class="lp-revista-program-month-column" t-att-data-month="month['number']" t-attf-id="lp-program-month-#{month['number']}">
                <header class="lp-revista-program-month-column__header">
                  <span><t t-out="month['event_count']"/> eventos</span>
                  <h2 t-out="month['name']"/>
                </header>
                <div t-if="not month['events']" class="lp-revista-program-month-column__empty">
                  Sin eventos publicados.
                </div>
                <article t-foreach="month['events']" t-as="event" class="lp-revista-program-month-event" t-att-data-event-type="event.event_type" t-att-data-event-modality="event.modality">
                  <div class="lp-revista-program-month-event__top">
                    <span class="lp-revista-kicker" t-out="event.event_type_label()"/>
                    <span class="lp-revista-program-card__mode" t-out="event.modality_label()"/>
                  </div>
                  <h3 t-out="event.name"/>
                  <p class="lp-revista-program-month-event__days">
                    <span>Días</span>
                    <strong t-out="event.program_days_label()"/>
                  </p>
                  <p class="lp-revista-program-month-event__time">
                    <i class="fa fa-clock-o"/>
                    <span t-out="event.time_label()"/>
                  </p>
                  <div class="lp-revista-program-month-event__actions">
                    <a t-if="event.location_url()" t-att-href="event.location_url()" target="_blank" rel="noopener">Ver</a>
                    <a t-if="event.registration_url" class="lp-revista-program-month-event__register" t-att-href="event.registration_url" target="_blank" rel="noopener">
                      <t t-out="event.button_label or 'Inscribirme'"/>
                    </a>
                    <t t-set="calendar_links" t-value="event.calendar_links()"/>
                    <details class="lp-revista-calendar-picker lp-revista-calendar-picker--compact">
                      <summary>Calendario <i class="fa fa-angle-down"/></summary>
                      <div>
                        <a t-att-href="calendar_links['google']" target="_blank" rel="noopener"><i class="fa fa-google"/> Google Calendar</a>
                        <a t-att-href="calendar_links['outlook']" target="_blank" rel="noopener"><i class="fa fa-windows"/> Outlook / Microsoft 365</a>
                        <a t-att-href="calendar_links['apple']"><i class="fa fa-apple"/> Apple Calendar</a>
                        <a t-att-href="calendar_links['ics']"><i class="fa fa-download"/> Descargar .ics</a>
                      </div>
                    </details>
                  </div>
                </article>
              </section>
            </div>
          </section>

          <section class="lp-revista-container lp-revista-block">
            <t t-call="latinpyme_revista_theme.lp_portfolio_strip"/>
          </section>

          <section class="lp-revista-container lp-revista-block">
            <t t-call="latinpyme_revista_theme.lp_allies_strip"/>
          </section>

          <section class="lp-revista-container lp-revista-block">
            <t t-set="lp_footer_banner" t-value="request.env['latinpyme.revista.banner'].sudo().get_active_banner('footer')"/>
            <t t-if="lp_footer_banner" t-call="latinpyme_revista_theme.lp_footer_with_ad"/>
            <t t-else="" t-call="latinpyme_revista_theme.lp_footer"/>
          </section>
        </main>
      </div>
    </t>
  </template>
</odoo>
