<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="revista_home_page" name="Revista LatinPyme Home">
    <t t-call="website.layout">
      <t t-set="title" t-value="'%s | Gerencia, negocios e innovación para pymes' % (lp_config.name if lp_config else 'Revista LatinPyme')"/>
      <t t-set="website_meta_description">Revista LatinPyme: contenidos de gerencia, negocios, inteligencia artificial, finanzas y actualidad para empresarios pyme.</t>
      <t t-set="seo_object" t-value="blog"/>
      <t t-set="section_slug" t-value="False"/>
      <t t-set="head">
        <meta t-if="lp_preproduction" name="robots" content="noindex,nofollow"/>
        <meta property="og:type" content="website"/>
        <meta property="og:title" content="Revista LatinPyme"/>
        <meta property="og:description" t-att-content="website_meta_description"/>
        <meta property="og:url" t-att-content="lp_production_url"/>
      </t>
      <div id="wrap" class="lp-revista lp-revista-home">
        <t t-call="latinpyme_revista_theme.lp_masthead"/>
        <main class="lp-revista-main" itemscope="itemscope" itemtype="https://schema.org/Periodical">
          <meta itemprop="name" t-att-content="lp_config.name if lp_config else 'Revista LatinPyme'"/>

          <section t-if="show_home_top_banners" class="lp-revista-container lp-revista-home-ads" aria-label="Destacados comerciales" t-att-style="'order: %s' % (home_blocks.get('top_banners').sequence if home_blocks.get('top_banners') else 5)">
            <t t-if="home_banners">
              <t t-foreach="home_banners" t-as="banner">
                <t t-call="latinpyme_revista_theme.lp_dynamic_banner"/>
              </t>
            </t>
            <t t-else="">
              <div class="lp-revista-promo-banner lp-revista-promo-banner--green">
                <h2>Lideramos conversaciones que impulsan un futuro sostenible y competitivo.</h2>
                <a href="/contactus" class="lp-revista-button">Conoce más <i class="fa fa-arrow-right"/></a>
              </div>
              <div class="lp-revista-promo-banner">
                <h2>Automatiza procesos, optimiza recursos y crece sin límites.</h2>
                <a href="/contactus" class="lp-revista-button">Conoce más <i class="fa fa-arrow-right"/></a>
                <span class="lp-revista-promo-banner__mark">LP</span>
              </div>
            </t>
          </section>

          <section t-if="show_home_hero" class="lp-revista-container lp-revista-hero-grid" aria-labelledby="lp-home-title" t-att-style="'order: %s' % (home_blocks.get('hero').sequence if home_blocks.get('hero') else 10)">
            <div class="lp-revista-hero-card" t-att-style="featured_style">
              <t t-if="featured_post">
                <t t-set="hero_tag" t-value="featured_post.tag_ids[:1]"/>
                <span t-if="hero_tag" class="lp-revista-kicker">
                  <t t-out="hero_tag.name"/>
                </span>
                <h1 id="lp-home-title">
                  <a t-att-href="featured_post.website_url" t-out="featured_post.name"/>
                </h1>
                <p t-out="featured_post.subtitle or featured_post.teaser"/>
                <time t-if="featured_post.post_date" t-att-datetime="featured_post.post_date.isoformat()">
                  <span t-field="featured_post.post_date" t-options="{'widget': 'date'}"/>
                </time>
              </t>
              <t t-else="">
                <h1 id="lp-home-title">Revista LatinPyme</h1>
                <p>Publica artículos en el blog Revista LatinPyme y así aparecerán en la portada editorial.</p>
              </t>
            </div>
            <div class="lp-revista-hero-rail">
              <t t-foreach="highlight_posts" t-as="post">
                <t t-call="latinpyme_revista_theme.lp_post_card">
                  <t t-set="variant" t-value="'mini'"/>
                </t>
              </t>
            </div>
            <t t-set="lp_sidebar_placement" t-value="'home'"/>
            <t t-call="latinpyme_revista_theme.lp_editorial_sidebar"/>
          </section>

          <section t-if="show_home_latest" class="lp-revista-container lp-revista-block" aria-labelledby="lp-latest-title" t-att-style="'order: %s' % (home_blocks.get('latest').sequence if home_blocks.get('latest') else 20)">
            <t t-call="latinpyme_revista_theme.lp_section_heading">
              <t t-set="title" t-value="home_blocks.get('latest').title if home_blocks.get('latest') and home_blocks.get('latest').title else 'Lo más reciente'"/>
              <t t-set="eyebrow" t-value="False"/>
              <t t-set="href" t-value="home_blocks.get('latest').link_url if home_blocks.get('latest') and home_blocks.get('latest').link_url else '/blog'"/>
              <t t-set="link_label" t-value="home_blocks.get('latest').link_label if home_blocks.get('latest') and home_blocks.get('latest').link_label else 'Ver archivo'"/>
            </t>
            <div class="lp-revista-card-grid lp-revista-card-grid--three">
              <t t-foreach="latest_posts[:3]" t-as="post">
                <t t-call="latinpyme_revista_theme.lp_post_card">
                  <t t-set="variant" t-value="'default'"/>
                </t>
              </t>
            </div>
          </section>

          <section t-if="show_home_sections or show_home_news" class="lp-revista-container lp-revista-block lp-revista-block--split" t-att-style="'order: %s' % (home_blocks.get('sections').sequence if home_blocks.get('sections') else 30)">
            <div t-if="show_home_sections">
              <t t-call="latinpyme_revista_theme.lp_section_heading">
                <t t-set="title" t-value="home_blocks.get('sections').title if home_blocks.get('sections') and home_blocks.get('sections').title else 'Secciones'"/>
                <t t-set="eyebrow" t-value="False"/>
                <t t-set="href" t-value="home_blocks.get('sections').link_url if home_blocks.get('sections') and home_blocks.get('sections').link_url else '/blog'"/>
                <t t-set="link_label" t-value="home_blocks.get('sections').link_label if home_blocks.get('sections') and home_blocks.get('sections').link_label else 'Ver más secciones'"/>
              </t>
              <div class="lp-revista-section-list">
                <t t-foreach="sections" t-as="section">
                  <a t-att-href="section['url']">
                    <span t-out="section['name']"/>
                    <i class="fa fa-angle-right"/>
                  </a>
                </t>
              </div>
            </div>
            <div t-if="show_home_news">
              <t t-call="latinpyme_revista_theme.lp_section_heading">
                <t t-set="title" t-value="home_blocks.get('news').title if home_blocks.get('news') and home_blocks.get('news').title else 'Novedades'"/>
                <t t-set="eyebrow" t-value="False"/>
                <t t-set="href" t-value="home_blocks.get('news').link_url if home_blocks.get('news') and home_blocks.get('news').link_url else False"/>
                <t t-set="link_label" t-value="home_blocks.get('news').link_label if home_blocks.get('news') and home_blocks.get('news').link_label else False"/>
              </t>
              <div class="lp-revista-list">
                <t t-foreach="new_posts" t-as="post">
                  <t t-call="latinpyme_revista_theme.lp_post_card">
                    <t t-set="variant" t-value="'horizontal'"/>
                  </t>
                </t>
              </div>
            </div>
          </section>

          <section t-if="show_home_interviews" class="lp-revista-container lp-revista-block" aria-labelledby="lp-interviews-title" t-att-style="'order: %s' % (home_blocks.get('interviews').sequence if home_blocks.get('interviews') else 50)">
            <t t-call="latinpyme_revista_theme.lp_section_heading">
              <t t-set="title" t-value="home_blocks.get('interviews').title if home_blocks.get('interviews') and home_blocks.get('interviews').title else 'Entrevistas'"/>
              <t t-set="eyebrow" t-value="False"/>
              <t t-set="href" t-value="home_blocks.get('interviews').link_url if home_blocks.get('interviews') and home_blocks.get('interviews').link_url else '/revista/seccion/entrevistas'"/>
              <t t-set="link_label" t-value="home_blocks.get('interviews').link_label if home_blocks.get('interviews') and home_blocks.get('interviews').link_label else 'Ver más entrevistas'"/>
            </t>
            <div class="lp-revista-interviews-grid">
              <div class="lp-revista-interview-cta">
                <i class="fa fa-microphone"/>
                <div>
                  <h3>¿Quieres ser parte de nuestras entrevistas?</h3>
                  <p>Comparte tu experiencia y conecta con nuestra audiencia empresarial.</p>
                  <a href="/contactus" class="lp-revista-button">Postúlate aquí <i class="fa fa-arrow-right"/></a>
                </div>
              </div>
              <t t-foreach="interviews" t-as="interview">
                <t t-call="latinpyme_revista_theme.lp_interview_card">
                  <t t-set="interview" t-value="interview"/>
                </t>
              </t>
            </div>
          </section>

          <section t-if="show_home_specials" class="lp-revista-container lp-revista-block" aria-labelledby="lp-specials-title" t-att-style="'order: %s' % (home_blocks.get('specials').sequence if home_blocks.get('specials') else 60)">
            <t t-call="latinpyme_revista_theme.lp_section_heading">
              <t t-set="title" t-value="home_blocks.get('specials').title if home_blocks.get('specials') and home_blocks.get('specials').title else 'Especiales'"/>
              <t t-set="eyebrow" t-value="False"/>
              <t t-set="href" t-value="home_blocks.get('specials').link_url if home_blocks.get('specials') and home_blocks.get('specials').link_url else '/revista/seccion/especiales'"/>
              <t t-set="link_label" t-value="home_blocks.get('specials').link_label if home_blocks.get('specials') and home_blocks.get('specials').link_label else 'Ver otros especiales'"/>
            </t>
            <div class="lp-revista-card-grid lp-revista-card-grid--two">
              <t t-foreach="special_posts" t-as="post">
                <t t-call="latinpyme_revista_theme.lp_post_card">
                  <t t-set="variant" t-value="'wide'"/>
                </t>
              </t>
            </div>
          </section>

          <section t-if="show_home_mid_banners" class="lp-revista-container lp-revista-block lp-revista-ad-row" aria-label="Publicidad" t-att-style="'order: %s' % (home_blocks.get('mid_banners').sequence if home_blocks.get('mid_banners') else 70)">
            <t t-if="home_mid_banners">
              <t t-foreach="home_mid_banners" t-as="banner">
                <t t-call="latinpyme_revista_theme.lp_dynamic_banner"/>
              </t>
            </t>
            <t t-else="" t-call="latinpyme_revista_theme.s_lp_revista_promo_banner"/>
          </section>

          <section t-if="show_home_portfolio" class="lp-revista-container lp-revista-block" t-att-style="'order: %s' % (home_blocks.get('portfolio').sequence if home_blocks.get('portfolio') else 80)">
            <t t-call="latinpyme_revista_theme.lp_portfolio_strip"/>
          </section>

          <section t-if="show_home_allies" class="lp-revista-container lp-revista-block" t-att-style="'order: %s' % (home_blocks.get('allies').sequence if home_blocks.get('allies') else 90)">
            <t t-call="latinpyme_revista_theme.lp_allies_strip"/>
          </section>

          <section class="lp-revista-container lp-revista-block" style="order: 1000">
            <t t-set="lp_footer_banner" t-value="request.env['latinpyme.revista.banner'].sudo().get_active_banner('footer')"/>
            <t t-if="lp_footer_banner" t-call="latinpyme_revista_theme.lp_footer_with_ad"/>
            <t t-else="" t-call="latinpyme_revista_theme.lp_footer"/>
          </section>
        </main>
      </div>
    </t>
  </template>
</odoo>
