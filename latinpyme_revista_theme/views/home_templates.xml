<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="revista_home_page" name="Revista LatinPyme Home">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>
      <t t-set="header_visible" t-value="False"/>
      <t t-set="footer_visible" t-value="False"/>
      <t t-set="title" t-value="'%s | Gerencia, negocios e innovación para pymes' % (lp_config.name if lp_config else 'Revista LatinPyme')"/>
      <t t-set="website_meta_description">Revista LatinPyme: contenidos de gerencia, negocios, inteligencia artificial, finanzas y actualidad para empresarios pyme.</t>
      <t t-set="seo_object" t-value="blog"/>
      <t t-set="section_slug" t-value="False"/>
      <t t-set="head">
        <meta t-if="lp_preproduction" name="robots" content="noindex,nofollow"/>
        <meta property="og:type" content="website"/>
        <meta property="og:title" content="Revista LatinPyme"/>
        <meta property="og:description" t-att-content="website_meta_description"/>
        <meta property="og:url" t-att-content="lp_production_url"/>
      </t>
      <div id="wrap" class="lp-revista lp-revista-home">
        <t t-call="latinpyme_revista_theme.lp_masthead"/>
        <main class="lp-revista-main" itemscope="itemscope" itemtype="https://schema.org/Periodical">
          <meta itemprop="name" t-att-content="lp_config.name if lp_config else 'Revista LatinPyme'"/>

          <section t-if="show_home_top_banners" class="lp-revista-container lp-revista-home-ads lp-revista-home-ads--single" aria-label="Destacados comerciales" style="order: 10" data-analytics-block-name="Publicidad superior">
            <t t-set="lp_home_top_banner" t-value="home_banners[:1] if home_banners else False"/>
            <t t-if="lp_home_top_banner">
              <t t-set="banner" t-value="lp_home_top_banner"/>
              <t t-call="latinpyme_revista_theme.lp_dynamic_banner"/>
            </t>
            <t t-else="">
              <div class="lp-revista-promo-banner lp-revista-promo-banner--green">
                <h2>Lideramos conversaciones que impulsan un futuro sostenible y competitivo.</h2>
                <a href="/contactus" class="lp-revista-button" data-analytics-event="click_home_ad_banner" data-analytics-item="banner" data-analytics-banner-name="Banner superior fallback" data-analytics-banner-position="home_top" data-analytics-link-text="Conoce más">Conoce más <i class="fa fa-arrow-right"/></a>
              </div>
            </t>
          </section>

          <section t-if="show_home_hero" class="lp-revista-container lp-revista-hero-grid lp-revista-hero-grid--home" aria-labelledby="lp-home-actualidad-title" style="order: 20" data-analytics-home-block="1" data-analytics-block-name="Actualidad">
            <header class="lp-revista-section-heading lp-revista-section-heading--home-hero">
              <h2 id="lp-home-actualidad-title">Actualidad</h2>
            </header>
            <div class="lp-revista-hero-card" t-att-style="featured_style">
              <t t-if="featured_post">
                <t t-set="hero_tag" t-value="featured_post.lp_revista_display_tag()"/>
                <span t-if="hero_tag" class="lp-revista-kicker">
                  <t t-out="hero_tag.name"/>
                </span>
                <h1 id="lp-home-title">
                  <a t-att-href="featured_post.website_url" t-out="featured_post.name" data-analytics-event="click_article" data-analytics-item="article" t-att-data-analytics-article-title="featured_post.name" t-att-data-analytics-article-url="featured_post.website_url"/>
                </h1>
                <p t-out="featured_post.subtitle or featured_post.teaser"/>
                <time t-if="featured_post.post_date" t-att-datetime="featured_post.post_date.isoformat()">
                  <span t-field="featured_post.post_date" t-options="{'widget': 'date'}"/>
                </time>
              </t>
              <t t-else="">
                <h1 id="lp-home-title">Revista LatinPyme</h1>
                <p>Publica artículos en el blog Revista LatinPyme y así aparecerán en la portada editorial.</p>
              </t>
            </div>
            <div class="lp-revista-hero-rail">
              <t t-foreach="highlight_posts" t-as="post">
                <t t-call="latinpyme_revista_theme.lp_post_card">
                  <t t-set="variant" t-value="'mini'"/>
                </t>
              </t>
            </div>
            <aside class="lp-revista-home-hero-aside" aria-label="Próxima conferencia">
              <t t-if="home_conference_item">
                <t t-set="item" t-value="home_conference_item"/>
                <t t-call="latinpyme_revista_theme.lp_sidebar_item_card"/>
              </t>
              <t t-else="" t-call="latinpyme_revista_theme.lp_sidebar_conference_card"/>
            </aside>
          </section>

          <section t-if="show_home_latest or show_home_sections" class="lp-revista-container lp-revista-block lp-revista-latest-layout" aria-labelledby="lp-latest-title" style="order: 30" data-analytics-home-block="1" data-analytics-block-name="De interés">
            <div class="lp-revista-latest-layout__main">
              <t t-call="latinpyme_revista_theme.lp_section_heading">
                <t t-set="lp_latest_title" t-value="home_blocks.get('latest').title if home_blocks.get('latest') and home_blocks.get('latest').title else 'De interés'"/>
                <t t-set="title" t-value="'De interés' if lp_latest_title in ('Lo mas reciente', 'Lo más reciente') else lp_latest_title"/>
                <t t-set="eyebrow" t-value="False"/>
                <t t-set="href" t-value="False"/>
                <t t-set="link_label" t-value="False"/>
              </t>
              <div class="lp-revista-latest-grid">
                <t t-if="show_home_latest">
                  <t t-foreach="latest_posts[:3]" t-as="post">
                    <t t-call="latinpyme_revista_theme.lp_post_card">
                      <t t-set="variant" t-value="'default'"/>
                    </t>
                  </t>
                </t>
                <aside t-if="show_home_sections" class="lp-revista-home-sections-mini" aria-label="Secciones">
                  <h3>Secciones</h3>
                  <div class="lp-revista-section-list lp-revista-section-list--mini">
                    <t t-foreach="home_section_links" t-as="section">
                      <a t-att-href="section['url']" data-analytics-event="click_site_link" t-att-data-analytics-link-text="section['name']">
                        <span t-out="section['name']"/>
                        <i class="fa fa-angle-right"/>
                      </a>
                    </t>
                  </div>
                  <a href="/revista/seccion" class="lp-revista-inline-link" data-analytics-event="click_site_link" data-analytics-link-text="Ver más secciones">
                    Ver más secciones <i class="fa fa-arrow-right"/>
                  </a>
                  <a href="/blog/revista-latinpyme-2" class="lp-revista-inline-link" data-analytics-event="click_site_link" data-analytics-link-text="Ver más artículos">
                    Ver más artículos <i class="fa fa-arrow-right"/>
                  </a>
                </aside>
              </div>
            </div>

            <aside class="lp-revista-latest-layout__aside" aria-label="Encuesta editorial">
              <t t-if="home_poll_item">
                <t t-set="item" t-value="home_poll_item"/>
                <t t-call="latinpyme_revista_theme.lp_sidebar_item_card"/>
              </t>
              <t t-else="" t-call="latinpyme_revista_theme.lp_sidebar_poll_card"/>
            </aside>
          </section>

          <section t-if="show_home_interviews" class="lp-revista-container lp-revista-block lp-revista-home-interviews" aria-labelledby="lp-interviews-title" style="order: 40" data-analytics-home-block="1" data-analytics-block-name="Entrevistas">
            <t t-set="lp_interviews_youtube_url" t-value="'https://www.youtube.com/@revistalatinpyme'"/>
            <t t-set="lp_interview_apply_url" t-value="lp_config.interview_apply_target_url() if lp_config else '/contactus'"/>
            <t t-call="latinpyme_revista_theme.lp_section_heading">
              <t t-set="title" t-value="home_blocks.get('interviews').title if home_blocks.get('interviews') and home_blocks.get('interviews').title else 'Entrevistas'"/>
              <t t-set="eyebrow" t-value="False"/>
              <t t-set="href" t-value="False"/>
              <t t-set="link_label" t-value="False"/>
            </t>
            <div class="lp-revista-interviews-grid lp-revista-interviews-grid--builder lp-revista-interviews-grid--home">
              <aside class="lp-revista-interview-featured">
                <span>Destacado</span>
                <div class="lp-revista-interview-featured__body">
                  <a t-att-href="lp_interviews_youtube_url" class="lp-revista-interview-featured__play" aria-label="Ver más entrevistas" target="_blank" rel="noopener" data-analytics-event="video_interview_play" data-analytics-video-title="Entrevistas Revista LatinPyme" data-analytics-video-provider="youtube" t-att-data-analytics-video-url="lp_interviews_youtube_url">
                    <i class="fa fa-play"/>
                  </a>
                  <p>Explora más entrevistas con líderes que están transformando negocios y comunidades.</p>
                </div>
                <a t-att-href="lp_interviews_youtube_url" class="lp-revista-inline-link" target="_blank" rel="noopener" data-analytics-event="video_interview_play" data-analytics-video-title="Entrevistas Revista LatinPyme" data-analytics-video-provider="youtube" t-att-data-analytics-video-url="lp_interviews_youtube_url">Ver más entrevistas <i class="fa fa-arrow-right"/></a>
              </aside>
              <div class="lp-revista-interviews-grid__cards">
                <t t-if="interviews">
                  <t t-foreach="interviews[:3]" t-as="interview">
                    <t t-call="latinpyme_revista_theme.lp_interview_card">
                      <t t-set="interview" t-value="interview"/>
                    </t>
                  </t>
                </t>
                <t t-if="not interviews">
                  <t t-foreach="interview_posts[:3]" t-as="post">
                    <t t-call="latinpyme_revista_theme.lp_post_card">
                      <t t-set="variant" t-value="'video'"/>
                    </t>
                  </t>
                </t>
              </div>
              <aside class="lp-revista-interview-cta lp-revista-interview-cta--join">
                <i class="fa fa-microphone"/>
                <div>
                  <h3>¿Quieres ser parte de nuestras entrevistas?</h3>
                  <p>Comparte tu experiencia y conecta con nuestra audiencia empresarial.</p>
                  <a t-att-href="lp_interview_apply_url" class="lp-revista-button" target="_blank" rel="noopener" data-analytics-event="click_site_link" data-analytics-cta-type="apply" data-analytics-link-text="Postúlate aquí">Postúlate aquí <i class="fa fa-arrow-right"/></a>
                </div>
              </aside>
            </div>
          </section>

          <section t-if="show_home_specials" class="lp-revista-container lp-revista-block lp-revista-home-specials" aria-labelledby="lp-specials-title" style="order: 50" data-analytics-home-block="1" data-analytics-block-name="Especiales">
            <t t-set="lp_specials_url" t-value="home_blocks.get('specials').link_url if home_blocks.get('specials') and home_blocks.get('specials').link_url else '/revista/seccion/especiales'"/>
            <t t-set="lp_specials_label" t-value="home_blocks.get('specials').link_label if home_blocks.get('specials') and home_blocks.get('specials').link_label else 'Ver otros especiales'"/>
            <t t-call="latinpyme_revista_theme.lp_section_heading">
              <t t-set="title" t-value="home_blocks.get('specials').title if home_blocks.get('specials') and home_blocks.get('specials').title else 'Especiales'"/>
              <t t-set="eyebrow" t-value="False"/>
              <t t-set="href" t-value="False"/>
              <t t-set="link_label" t-value="False"/>
            </t>
            <div class="lp-revista-home-specials__grid">
              <t t-set="lp_special_posts" t-value="special_posts[:2]"/>
              <t t-foreach="lp_special_posts" t-as="post">
                <article class="lp-revista-special-card" data-analytics-item="article">
                  <a class="lp-revista-special-card__media-link" t-att-href="post.website_url" t-att-title="post.name" data-analytics-event="click_article" t-att-data-analytics-article-title="post.name" t-att-data-analytics-article-url="post.website_url">
                    <t t-call="website.record_cover">
                      <t t-set="_record" t-value="post"/>
                      <t t-set="use_filters" t-value="True"/>
                      <t t-set="use_size" t-value="False"/>
                      <t t-set="additionnal_classes" t-value="'lp-revista-special-card__media'"/>
                    </t>
                  </a>
                  <span class="lp-revista-special-card__shade"/>
                  <div class="lp-revista-special-card__body">
                    <span class="lp-revista-special-card__label">Especial</span>
                    <h3>
                      <a t-att-href="post.website_url" t-out="post.name" data-analytics-event="click_article" t-att-data-analytics-article-title="post.name" t-att-data-analytics-article-url="post.website_url"/>
                    </h3>
                    <time t-if="post.post_date" t-att-datetime="post.post_date.isoformat()">
                      <span t-field="post.post_date" t-options="{'widget': 'date'}"/>
                    </time>
                  </div>
                </article>
              </t>
              <t t-set="lp_specials_banner" t-value="home_specials_banner[:1] if home_specials_banner else False"/>
              <t t-set="lp_specials_banner_image_only" t-value="lp_specials_banner and (lp_specials_banner.display_mode or 'image_only') == 'image_only'"/>
              <t t-set="lp_specials_banner_href" t-value="lp_specials_banner.url if lp_specials_banner and lp_specials_banner.url else (False if lp_specials_banner_image_only else '/contactus')"/>
              <a t-att-class="'lp-revista-special-banner' + (' lp-revista-special-banner--image-only' if lp_specials_banner_image_only else '')" t-att-href="lp_specials_banner_href" aria-label="Publicidad LatinPyme" data-analytics-event="click_home_ad_banner" data-analytics-item="banner" t-att-data-analytics-banner-name="lp_specials_banner.name if lp_specials_banner else 'Banner especiales'" data-analytics-banner-position="home_specials">
                <img t-if="lp_specials_banner and lp_specials_banner.image" class="lp-revista-special-banner__image" t-att-src="'/revista/media/banner/%s/image' % lp_specials_banner.id" t-att-alt="lp_specials_banner.name" loading="lazy"/>
                <t t-if="not lp_specials_banner_image_only">
                  <span class="lp-revista-special-banner__shade"/>
                  <span class="lp-revista-special-banner__label">Publicidad</span>
                  <strong class="lp-revista-special-banner__title" t-out="lp_specials_banner.title if lp_specials_banner and lp_specials_banner.title else 'Potencia tu empresa con soluciones que generan resultados'"/>
                  <span t-if="lp_specials_banner and lp_specials_banner.text" class="lp-revista-special-banner__text" t-out="lp_specials_banner.text"/>
                  <span class="lp-revista-button lp-revista-button--small">
                    <t t-out="lp_specials_banner.button_label if lp_specials_banner and lp_specials_banner.button_label else 'Conoce más'"/> <i class="fa fa-arrow-right"/>
                  </span>
                  <span class="lp-revista-special-banner__mark">LP</span>
                </t>
              </a>
            </div>
            <a t-att-href="lp_specials_url" class="lp-revista-home-specials__more" data-analytics-event="click_site_link" t-att-data-analytics-link-text="lp_specials_label">
              <t t-out="lp_specials_label"/> <i class="fa fa-arrow-right"/>
            </a>
          </section>

          <section t-if="show_home_mid_banners" class="lp-revista-container lp-revista-block lp-revista-ad-row" aria-label="Publicidad" style="order: 70" data-analytics-block-name="Publicidad intermedia">
            <t t-set="lp_mid_banner_left" t-value="home_mid_banners[:1] if home_mid_banners else False"/>
            <t t-set="lp_mid_banner_right" t-value="home_mid_banners[1:2] if home_mid_banners else False"/>
            <div class="lp-revista-ad-row__grid">
              <t t-if="lp_mid_banner_left">
                <t t-set="banner" t-value="lp_mid_banner_left"/>
                <t t-call="latinpyme_revista_theme.lp_dynamic_banner"/>
              </t>
              <a t-else="" href="/contactus" class="lp-revista-promo-banner lp-revista-promo-banner--dynamic lp-revista-promo-banner--city" data-analytics-event="click_home_ad_banner" data-analytics-item="banner" data-analytics-banner-name="Banner intermedio fallback 1" data-analytics-banner-position="home_horizontal" data-analytics-link-text="Conoce más">
                <span class="lp-revista-promo-banner__shade"/>
                <h2>Automatiza procesos, optimiza recursos y crece sin límites.</h2>
                <span class="lp-revista-button">Conoce más <i class="fa fa-arrow-right"/></span>
                <span class="lp-revista-promo-banner__mark">LP</span>
              </a>
              <t t-if="lp_mid_banner_right">
                <t t-set="banner" t-value="lp_mid_banner_right"/>
                <t t-call="latinpyme_revista_theme.lp_dynamic_banner"/>
              </t>
              <a t-else="" href="/contactus" class="lp-revista-promo-banner lp-revista-promo-banner--dynamic lp-revista-promo-banner--sustainable" data-analytics-event="click_home_ad_banner" data-analytics-item="banner" data-analytics-banner-name="Banner intermedio fallback 2" data-analytics-banner-position="home_horizontal" data-analytics-link-text="Conoce más">
                <span class="lp-revista-promo-banner__shade"/>
                <h2>Soluciones para un futuro más sostenible y competitivo.</h2>
                <span class="lp-revista-button">Conoce más <i class="fa fa-arrow-right"/></span>
              </a>
            </div>
          </section>

          <section t-if="show_home_news" class="lp-revista-container lp-revista-block lp-revista-news-strip" style="order: 60" data-analytics-home-block="1" data-analytics-block-name="Novedades">
              <t t-call="latinpyme_revista_theme.lp_section_heading">
                <t t-set="title" t-value="home_blocks.get('news').title if home_blocks.get('news') and home_blocks.get('news').title else 'Novedades'"/>
                <t t-set="eyebrow" t-value="False"/>
                <t t-set="href" t-value="home_blocks.get('news').link_url if home_blocks.get('news') and home_blocks.get('news').link_url else False"/>
                <t t-set="link_label" t-value="home_blocks.get('news').link_label if home_blocks.get('news') and home_blocks.get('news').link_label else False"/>
              </t>
              <div class="lp-revista-list lp-revista-news-strip__grid">
                <t t-set="lp_news_posts" t-value="new_posts[:3]"/>
                <t t-foreach="lp_news_posts" t-as="post">
                  <t t-call="latinpyme_revista_theme.lp_post_card">
                    <t t-set="variant" t-value="'horizontal'"/>
                  </t>
                </t>
                <t t-set="lp_news_banner" t-value="home_news_banner[:1] if home_news_banner else False"/>
                <t t-set="lp_news_banner_image_only" t-value="lp_news_banner and (lp_news_banner.display_mode or 'image_only') == 'image_only'"/>
                <t t-set="lp_news_banner_href" t-value="lp_news_banner.url if lp_news_banner and lp_news_banner.url else (False if lp_news_banner_image_only else '/contactus')"/>
                <a t-att-class="'lp-revista-news-banner' + (' lp-revista-news-banner--image-only' if lp_news_banner_image_only else '')" t-att-href="lp_news_banner_href" aria-label="Publicidad LatinPyme" data-analytics-event="click_home_ad_banner" data-analytics-item="banner" t-att-data-analytics-banner-name="lp_news_banner.name if lp_news_banner else 'Banner novedades'" data-analytics-banner-position="home_news">
                  <img t-if="lp_news_banner and lp_news_banner.image" class="lp-revista-news-banner__image" t-att-src="'/revista/media/banner/%s/image' % lp_news_banner.id" t-att-alt="lp_news_banner.name" loading="lazy"/>
                  <t t-if="not lp_news_banner_image_only">
                    <span class="lp-revista-news-banner__shade"/>
                    <span class="lp-revista-news-banner__label">Publicidad</span>
                    <strong class="lp-revista-news-banner__title" t-out="lp_news_banner.title if lp_news_banner and lp_news_banner.title else 'Impulsa tu marca con LatinPyme'"/>
                    <span class="lp-revista-news-banner__cta">
                      <t t-out="lp_news_banner.button_label if lp_news_banner and lp_news_banner.button_label else 'Conoce más'"/> <i class="fa fa-arrow-right"/>
                    </span>
                  </t>
                </a>
              </div>
          </section>

          <section t-if="show_home_portfolio" class="lp-revista-container lp-revista-block" style="order: 80" data-analytics-home-block="1" data-analytics-block-name="Portafolio">
            <t t-call="latinpyme_revista_theme.lp_portfolio_strip"/>
          </section>

          <section t-if="show_home_allies" class="lp-revista-container lp-revista-block lp-revista-home-allies" style="order: 90" data-analytics-home-block="1" data-analytics-block-name="Aliados">
            <t t-call="latinpyme_revista_theme.lp_home_allies_carousel"/>
          </section>

          <section class="lp-revista-container lp-revista-block" style="order: 1000">
            <t t-set="lp_footer_banner" t-value="request.env['latinpyme.revista.banner'].sudo().get_active_banner('footer')"/>
            <t t-if="lp_footer_banner" t-call="latinpyme_revista_theme.lp_footer_with_ad"/>
            <t t-else="" t-call="latinpyme_revista_theme.lp_footer"/>
          </section>
        </main>
      </div>
    </t>
  </template>
</odoo>
