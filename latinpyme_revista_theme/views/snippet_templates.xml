<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lp_masthead" name="Revista LatinPyme Masthead">
    <header class="lp-revista-masthead" role="banner">
      <div class="lp-revista-container lp-revista-masthead__top">
        <a href="/revista" class="lp-revista-brand" aria-label="Revista LatinPyme">
          <span class="lp-revista-brand__mark">LP</span>
          <span class="lp-revista-brand__text">
            <span>Revista</span>
            <strong>LatinPyme</strong>
          </span>
        </a>
        <div class="lp-revista-anniversary">
          <strong>25 años</strong>
          <span>Impulsando empresarios en Latinoamérica</span>
        </div>
        <form class="lp-revista-search" action="/website/search" method="get" role="search">
          <input type="search" name="search" placeholder="Buscar noticias, artículos, recursos..." aria-label="Buscar en Revista LatinPyme"/>
          <button type="submit" aria-label="Buscar">
            <i class="fa fa-search"/>
          </button>
        </form>
        <div class="lp-revista-social" aria-label="Redes sociales">
          <a href="#" aria-label="Facebook"><i class="fa fa-facebook"/></a>
          <a href="#" aria-label="LinkedIn"><i class="fa fa-linkedin"/></a>
          <a href="#" aria-label="Instagram"><i class="fa fa-instagram"/></a>
          <a href="#" aria-label="YouTube"><i class="fa fa-youtube-play"/></a>
          <a href="#" class="lp-revista-social__whatsapp" aria-label="WhatsApp"><i class="fa fa-whatsapp"/></a>
        </div>
      </div>
      <nav class="lp-revista-nav" aria-label="Secciones Revista LatinPyme">
        <div class="lp-revista-container lp-revista-nav__inner">
          <a href="/revista" t-attf-class="lp-revista-nav__link #{'is-active' if not section_slug else ''}">Inicio</a>
          <t t-foreach="sections" t-as="section">
            <a t-att-href="section['url']" t-attf-class="lp-revista-nav__link #{'is-active' if section.get('slug') == section_slug else ''}">
              <t t-out="section['name']"/>
            </a>
          </t>
          <a href="/suscribirse" class="lp-revista-button lp-revista-button--nav">Suscribirse</a>
        </div>
      </nav>
    </header>
  </template>

