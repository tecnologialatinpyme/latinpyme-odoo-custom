      </a>
    </header>
  </template>

  <template id="lp_post_card" name="Revista LatinPyme Post Card">
    <t t-set="variant" t-value="variant or 'card'"/>
    <article t-if="post" t-attf-class="lp-revista-post-card lp-revista-post-card--#{variant}" itemscope="itemscope" itemtype="https://schema.org/Article">
      <a class="lp-revista-post-card__media-link" t-att-href="post.website_url" t-att-title="post.name">
        <t t-call="website.record_cover">
          <t t-set="_record" t-value="post"/>
          <t t-set="use_filters" t-value="True"/>
          <t t-set="use_size" t-value="False"/>
          <t t-set="additionnal_classes" t-value="'lp-revista-post-card__media'"/>
        </t>
      </a>
      <div class="lp-revista-post-card__body">
        <t t-set="primary_tag" t-value="post.tag_ids[:1]"/>
        <span t-if="primary_tag" class="lp-revista-kicker" itemprop="articleSection">
          <t t-out="primary_tag.name"/>
        </span>
        <h3 class="lp-revista-post-card__title" itemprop="headline">
          <a t-att-href="post.website_url" t-out="post.name"/>
        </h3>
        <p t-if="variant in ('hero', 'feature', 'default', 'wide')" class="lp-revista-post-card__teaser" t-out="post.subtitle or post.teaser"/>
        <time t-if="post.post_date" class="lp-revista-date" itemprop="datePublished" t-att-datetime="post.post_date.isoformat()">
          <span t-field="post.post_date" t-options="{'widget': 'date'}"/>
        </time>
      </div>
    </article>
  </template>

