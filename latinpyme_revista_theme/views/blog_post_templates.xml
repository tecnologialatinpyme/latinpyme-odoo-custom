<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lp_revista_blog_scope" inherit_id="website_blog.index" name="Revista LatinPyme Blog Scope">
    <xpath expr="//div[@id='wrap']" position="attributes">
      <attribute name="class" add="lp-revista lp-revista--native-blog" separator=" "/>
    </xpath>
  </template>

  <template id="lp_revista_blog_sections_context" name="Revista LatinPyme Blog Sections Context">
    <t t-set="lp_section_records" t-value="request.env['latinpyme.revista.section'].sudo().get_active_sections()"/>
    <t t-set="sections" t-value="[{'slug': section.slug, 'name': section.name, 'url': '/revista/seccion/%s' % section.slug} for section in lp_section_records] or [{'slug': 'gerencia', 'name': 'Gerencia', 'url': '/revista/seccion/gerencia'}, {'slug': 'negocios', 'name': 'Negocios', 'url': '/revista/seccion/negocios'}, {'slug': 'ia', 'name': 'IA', 'url': '/revista/seccion/ia'}, {'slug': 'laboral', 'name': 'Laboral', 'url': '/revista/seccion/laboral'}, {'slug': 'finanzas', 'name': 'Finanzas', 'url': '/revista/seccion/finanzas'}, {'slug': 'entrevistas', 'name': 'Entrevistas', 'url': '/revista/seccion/entrevistas'}, {'slug': 'especiales', 'name': 'Especiales', 'url': '/revista/seccion/especiales'}, {'slug': 'mujeres', 'name': 'Mujeres', 'url': '/revista/seccion/mujeres'}, {'slug': 'portafolio', 'name': 'Portafolio', 'url': '/revista/seccion/portafolio'}]"/>
    <t t-set="section_slug" t-value="False"/>
  </template>

  <template id="lp_revista_blog_list_preproduction_noindex" inherit_id="website_blog.blog_post_short" name="Revista LatinPyme Blog List Preproduction SEO">
    <xpath expr="//t[@t-set='head']" position="inside">
      <t t-set="lp_host" t-value="request.httprequest.host.split(':', 1)[0].lower()"/>
      <meta t-if="lp_host == 'revista.latinpyme.com' or lp_host.endswith('.odoo.com') or lp_host.endswith('.odoo.sh')" name="robots" content="noindex,nofollow"/>
    </xpath>
  </template>

  <template id="lp_revista_blog_post_seo" inherit_id="website_blog.blog_post_complete" name="Revista LatinPyme Blog Post SEO">
    <xpath expr="//t[@t-call='website_blog.index']/t[1]" position="before">
      <t t-set="lp_config" t-value="request.env['latinpyme.revista.config'].sudo().get_active_config()"/>
      <t t-set="lp_note_override" t-value="request.env['latinpyme.revista.blog.post.override'].sudo().get_for_post(blog_post)"/>
      <t t-set="lp_host" t-value="request.httprequest.host.split(':', 1)[0].lower()"/>
      <t t-set="lp_current_url" t-value="'%s%s' % (request.httprequest.url_root.rstrip('/'), blog_post.website_url)"/>
      <t t-set="lp_final_host" t-value="lp_config.domain_to_host(lp_config.production_domain) if lp_config else 'latinpyme.com'"/>
      <t t-set="lp_final_url" t-value="'%s%s' % ((lp_config.production_base_url() if lp_config else 'https://latinpyme.com'), blog_post.website_url)"/>
      <t t-set="lp_og_url" t-value="lp_note_override.canonical_url if lp_note_override and lp_note_override.canonical_url else (lp_final_url if lp_host == lp_final_host else lp_current_url)"/>
      <t t-set="lp_media_base_url" t-value="(lp_config.production_base_url() if lp_config else 'https://latinpyme.com') if lp_host == lp_final_host else request.httprequest.url_root.rstrip('/')"/>
      <t t-set="lp_seo_title" t-value="lp_note_override.seo_title if lp_note_override and lp_note_override.seo_title else blog_post.name"/>
      <t t-set="lp_seo_description" t-value="lp_note_override.seo_description if lp_note_override and lp_note_override.seo_description else (blog_post.subtitle or blog_post.teaser or '')"/>
      <t t-set="head">
        <meta t-if="lp_config and lp_config.is_preproduction_host(lp_host)" name="robots" content="noindex,nofollow"/>
        <meta t-if="lp_seo_description" name="description" t-att-content="lp_seo_description"/>
        <meta property="og:type" content="article"/>
        <meta property="og:title" t-att-content="lp_seo_title"/>
        <meta property="og:description" t-att-content="lp_seo_description"/>
        <meta property="og:url" t-att-content="lp_og_url"/>
        <meta t-if="'image_1920' in blog_post._fields" property="og:image" t-att-content="'%s/web/image/blog.post/%s/image_1920' % (lp_media_base_url, blog_post.id)"/>
        <meta t-if="blog_post.post_date" property="article:published_time" t-att-content="blog_post.post_date.isoformat()"/>
      </t>
    </xpath>
  </template>

  <template id="lp_revista_blog_post_visual" inherit_id="website_blog.blog_post_complete" name="Revista LatinPyme Blog Post Editorial Layout">
    <xpath expr="//section[@id='o_wblog_post_top']" position="before">
      <t t-set="lp_config" t-value="request.env['latinpyme.revista.config'].sudo().get_active_config()"/>
      <t t-call="latinpyme_revista_theme.lp_revista_blog_sections_context"/>
      <t t-set="lp_nav_primary_tag" t-value="blog_post.tag_ids[:1]"/>
      <t t-set="lp_nav_primary_section" t-value="request.env['latinpyme.revista.section'].sudo().get_by_tag(lp_nav_primary_tag) if lp_nav_primary_tag else False"/>
      <t t-set="section_slug" t-value="lp_nav_primary_section.slug if lp_nav_primary_section else False"/>
      <div class="lp-revista-blog-masthead">
        <t t-call="latinpyme_revista_theme.lp_masthead"/>
      </div>
    </xpath>

    <xpath expr="//section[@id='o_wblog_post_top']" position="replace">
      <section id="o_wblog_post_top" class="lp-revista-blog-hero">
        <t t-set="lp_primary_tag" t-value="blog_post.tag_ids[:1]"/>
        <t t-set="lp_blog_post_public" t-value="blog_post.sudo()"/>
        <t t-set="lp_author_name" t-value="lp_blog_post_public.author_name or 'Equipo LatinPyme'"/>
        <t t-set="lp_section_model" t-value="request.env['latinpyme.revista.section'].sudo()"/>
        <t t-set="lp_primary_section" t-value="lp_section_model.get_by_tag(lp_primary_tag) if lp_primary_tag else False"/>
        <t t-set="lp_primary_tag_name" t-value="lp_primary_tag.name if lp_primary_tag else 'Revista'"/>
        <t t-set="lp_primary_section_url" t-value="'/revista/seccion/%s' % lp_primary_section.slug if lp_primary_section else '/revista'"/>
        <t t-set="lp_share_host" t-value="request.httprequest.host.split(':', 1)[0].lower()"/>
        <t t-set="lp_share_url" t-value="'%s%s' % ((lp_config.production_base_url() if lp_config else 'https://latinpyme.com'), blog_post.website_url) if lp_config and lp_share_host == lp_config.domain_to_host(lp_config.production_domain) else '%s%s' % (request.httprequest.url_root.rstrip('/'), blog_post.website_url)"/>
        <t t-set="lp_note_override" t-value="request.env['latinpyme.revista.blog.post.override'].sudo().get_for_post(blog_post)"/>
        <t t-set="lp_default_note_sidebar" t-value="not lp_config or lp_config.show_note_sidebar"/>
        <t t-set="lp_section_note_sidebar" t-value="lp_primary_section.display_mode_enabled('note_sidebar_mode', lp_default_note_sidebar) if lp_primary_section else lp_default_note_sidebar"/>
        <t t-set="lp_show_note_sidebar" t-value="lp_note_override.display_mode_enabled('sidebar_mode', lp_section_note_sidebar) if lp_note_override else lp_section_note_sidebar"/>
        <t t-set="lp_sidebar_model" t-value="request.env['latinpyme.revista.sidebar.item'].sudo()"/>
        <t t-set="lp_note_conference_item" t-value="lp_sidebar_model.get_active_item('note', 'conference')"/>
        <t t-set="lp_show_note_conference" t-value="lp_show_note_sidebar and (lp_note_conference_item or not lp_config or lp_config.show_sidebar_conference)"/>

        <div class="lp-revista-container lp-revista-note-head lp-revista-blog-hero__inner">
          <nav class="lp-revista-breadcrumb lp-revista-breadcrumb--dark" aria-label="Miga de pan">
            <a href="/revista">Inicio</a>
            <span aria-hidden="true">&gt;</span>
            <a t-if="lp_primary_section" t-att-href="lp_primary_section_url" t-out="lp_primary_section.name"/>
            <span t-if="not lp_primary_section" t-out="lp_primary_tag_name"/>
            <span aria-hidden="true">&gt;</span>
            <span class="lp-revista-breadcrumb__current" t-out="blog_post.name"/>
          </nav>

          <div t-attf-class="lp-revista-blog-hero__grid #{'lp-revista-blog-hero__grid--with-aside' if lp_show_note_conference else ''}">
            <div class="lp-revista-blog-hero__copy">
              <span t-if="lp_primary_tag" class="lp-revista-kicker" itemprop="articleSection" t-out="lp_primary_tag_name"/>

              <div id="title" class="blog_header lp-revista-blog-hero__title" t-ignore="False">
                <h1 t-field="blog_post.name" class="o_wblog_post_name"/>
                <p t-if="blog_post.subtitle or blog_post.teaser" class="o_wblog_post_subtitle" t-out="blog_post.subtitle or blog_post.teaser"/>
                <div class="lp-revista-note-meta">
                  <span>
                    <i class="fa fa-user"/>
                    <t t-out="lp_author_name"/>
                  </span>
                  <span t-if="blog_post.post_date">
                    <i class="fa fa-calendar"/>
                    <span t-field="blog_post.post_date" t-options="{'widget': 'date'}"/>
                  </span>
                </div>
              </div>

              <div class="lp-revista-share lp-revista-share--hero" aria-label="Compartir nota">
                <strong>Compartir:</strong>
                <a t-att-href="'https://www.facebook.com/sharer/sharer.php?u=%s' % lp_share_url" target="_blank" rel="noopener" aria-label="Compartir en Facebook"><i class="fa fa-facebook"/></a>
                <a t-att-href="'https://www.linkedin.com/sharing/share-offsite/?url=%s' % lp_share_url" target="_blank" rel="noopener" aria-label="Compartir en LinkedIn"><i class="fa fa-linkedin"/></a>
                <a t-att-href="'https://twitter.com/intent/tweet?url=%s' % lp_share_url" target="_blank" rel="noopener" aria-label="Compartir en X"><i class="fa fa-twitter"/></a>
                <a t-att-href="'mailto:?subject=%s&amp;body=%s' % (blog_post.name, lp_share_url)" aria-label="Compartir por correo"><i class="fa fa-envelope"/></a>
              </div>
            </div>

            <div class="lp-revista-blog-hero__cover" aria-label="Imagen principal">
              <t t-call="website.record_cover">
                <t t-set="_record" t-value="blog_post"/>
                <t t-set="snippet_autofocus" t-value="True"/>
                <t t-set="use_filters" t-value="True"/>
                <t t-set="use_size" t-value="True"/>
                <t t-set="display_opt_name">Blog Post Cover</t>
                <t t-set="additionnal_classes" t-value="'lp-revista-blog-hero__image o_wblog_post_page_cover'"/>
              </t>
            </div>

            <aside t-if="lp_show_note_conference" class="lp-revista-blog-hero__aside" aria-label="Próxima conferencia">
              <t t-if="lp_note_conference_item">
                <t t-set="item" t-value="lp_note_conference_item"/>
                <t t-call="latinpyme_revista_theme.lp_sidebar_item_card"/>
              </t>
              <t t-else="" t-call="latinpyme_revista_theme.lp_sidebar_conference_card"/>
            </aside>
          </div>
        </div>
      </section>
    </xpath>

    <xpath expr="//section[@id='o_wblog_post_main']" position="attributes">
      <attribute name="class" add="lp-revista-post-main" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='o_wblog_post_content']" position="attributes">
      <attribute name="class" add="lp-revista-post-content" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='o_wblog_post_content']/parent::*" position="attributes">
      <attribute name="class" add="lp-revista-post-content-shell" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='o_wblog_post_content']/parent::*/parent::*" position="attributes">
      <attribute name="class" add="lp-revista-post-content-row" separator=" "/>
    </xpath>
    <xpath expr="//section[@id='o_wblog_post_footer']" position="attributes">
      <attribute name="class" add="lp-revista-post-footer" separator=" "/>
    </xpath>
    <xpath expr="//section[@id='o_wblog_post_footer']" position="inside">
      <t t-set="lp_config" t-value="request.env['latinpyme.revista.config'].sudo().get_active_config()"/>
      <t t-set="lp_note_override" t-value="request.env['latinpyme.revista.blog.post.override'].sudo().get_for_post(blog_post)"/>
      <t t-set="lp_note_primary_tag" t-value="blog_post.tag_ids[:1]"/>
      <t t-set="lp_note_section" t-value="request.env['latinpyme.revista.section'].sudo().get_by_tag(lp_note_primary_tag) if lp_note_primary_tag else False"/>
      <t t-set="lp_default_note_related" t-value="True"/>
      <t t-set="lp_default_note_interviews" t-value="not lp_config or lp_config.show_note_interviews"/>
      <t t-set="lp_default_note_portfolio" t-value="not lp_config or lp_config.show_note_portfolio"/>
      <t t-set="lp_default_note_allies" t-value="not lp_config or lp_config.show_note_allies"/>
      <t t-set="lp_section_note_interviews" t-value="lp_note_section.display_mode_enabled('note_interviews_mode', lp_default_note_interviews) if lp_note_section else lp_default_note_interviews"/>
      <t t-set="lp_section_note_portfolio" t-value="lp_note_section.display_mode_enabled('note_portfolio_mode', lp_default_note_portfolio) if lp_note_section else lp_default_note_portfolio"/>
      <t t-set="lp_section_note_allies" t-value="lp_note_section.display_mode_enabled('note_allies_mode', lp_default_note_allies) if lp_note_section else lp_default_note_allies"/>
      <t t-set="lp_show_note_related" t-value="lp_note_override.display_mode_enabled('related_posts_mode', lp_default_note_related) if lp_note_override else lp_default_note_related"/>
      <t t-set="lp_show_note_interviews" t-value="lp_note_override.display_mode_enabled('interviews_mode', lp_section_note_interviews) if lp_note_override else lp_section_note_interviews"/>
      <t t-set="lp_show_note_portfolio" t-value="lp_note_override.display_mode_enabled('portfolio_mode', lp_section_note_portfolio) if lp_note_override else lp_section_note_portfolio"/>
      <t t-set="lp_show_note_allies" t-value="lp_note_override.display_mode_enabled('allies_mode', lp_section_note_allies) if lp_note_override else lp_section_note_allies"/>
      <div class="lp-revista-container lp-revista-blog-post-addons">
        <t t-if="lp_show_note_related" t-call="latinpyme_revista_theme.lp_blog_related_posts"/>
        <t t-if="lp_show_note_interviews" t-call="latinpyme_revista_theme.lp_blog_related_interviews"/>
        <t t-set="lp_note_banner" t-value="lp_note_override.note_banner_id if lp_note_override and lp_note_override.note_banner_id and lp_note_override.note_banner_id.active else (lp_note_section.note_banner_id if lp_note_section and lp_note_section.note_banner_id and lp_note_section.note_banner_id.active else request.env['latinpyme.revista.banner'].sudo().get_active_banner('note'))"/>
        <section t-if="lp_note_banner" class="lp-revista-block lp-revista-ad-row">
          <t t-call="latinpyme_revista_theme.lp_dynamic_banner">
            <t t-set="banner" t-value="lp_note_banner"/>
          </t>
        </section>
        <section t-if="lp_show_note_portfolio" class="lp-revista-block">
          <t t-call="latinpyme_revista_theme.lp_portfolio_strip"/>
        </section>
        <section t-if="lp_show_note_allies" class="lp-revista-block lp-revista-home-allies">
          <t t-set="home_allies" t-value="request.env['latinpyme.revista.ally'].sudo().get_active_allies(request.website)"/>
          <t t-call="latinpyme_revista_theme.lp_home_allies_carousel"/>
        </section>
        <section class="lp-revista-block">
          <t t-call="latinpyme_revista_theme.lp_footer"/>
        </section>
      </div>
    </xpath>
  </template>

  <template id="lp_revista_blog_post_content_visual" inherit_id="website_blog.blog_post_content" name="Revista LatinPyme Blog Post Content Visual">
    <xpath expr="//div[contains(@t-attf-class, 'o_wblog_post_content_field')]/parent::*" position="attributes">
      <attribute name="t-attf-class" add="lp-revista-post-body-grid" separator=" "/>
    </xpath>
    <xpath expr="//div[contains(@t-attf-class, 'o_wblog_post_content_field')]" position="attributes">
      <attribute name="t-attf-class" add="lp-revista-article-body" separator=" "/>
    </xpath>
    <xpath expr="//div[contains(@t-attf-class, 'o_wblog_post_content_field')]" position="before">
      <t t-set="lp_blog_post_public" t-value="blog_post.sudo()"/>
      <t t-set="lp_author_name" t-value="lp_blog_post_public.author_name or 'Equipo LatinPyme'"/>
      <div class="lp-revista-blog-post-tools">
        <div class="lp-revista-author-box">
          <img t-if="lp_blog_post_public.author_avatar" t-att-src="'/revista/media/blog-post/%s/author-avatar' % blog_post.id" t-att-alt="lp_author_name"/>
          <img t-else="" src="/latinpyme_revista_theme/static/src/img/editorial/interview-placeholder.svg" t-att-alt="lp_author_name"/>
          <div>
            <strong>
              <t t-out="lp_author_name"/>
            </strong>
            <p>Autor</p>
            <span t-if="blog_post.post_date" t-field="blog_post.post_date" t-options="{'widget': 'date'}"/>
          </div>
        </div>
      </div>
    </xpath>
  </template>

  <template id="lp_blog_related_posts" name="Revista LatinPyme Related Blog Posts">
    <t t-set="lp_post_model" t-value="request.env['blog.post'].sudo()"/>
    <t t-set="lp_publish_domain" t-value="[('website_published', '=', True)] if 'website_published' in lp_post_model._fields else ([('is_published', '=', True)] if 'is_published' in lp_post_model._fields else [])"/>
    <t t-set="lp_related_posts" t-value="lp_post_model.search([('blog_id', '=', blog_post.blog_id.id), ('id', '!=', blog_post.id)] + lp_publish_domain, order='post_date desc, id desc', limit=3)"/>
    <section t-if="lp_related_posts" class="lp-revista-block lp-revista-blog-related" aria-labelledby="lp-blog-related-title">
      <t t-call="latinpyme_revista_theme.lp_section_heading">
        <t t-set="title">Artículos relacionados</t>
        <t t-set="eyebrow" t-value="False"/>
        <t t-set="href">/blog</t>
        <t t-set="link_label">Ver archivo</t>
      </t>
      <div class="lp-revista-card-grid lp-revista-card-grid--three">
        <t t-foreach="lp_related_posts" t-as="post">
          <t t-call="latinpyme_revista_theme.lp_post_card">
            <t t-set="variant" t-value="'default'"/>
          </t>
        </t>
      </div>
    </section>
  </template>

  <template id="lp_blog_related_interviews" name="Revista LatinPyme Related Interviews">
    <t t-set="lp_interviews" t-value="request.env['latinpyme.revista.interview'].sudo().get_active_interviews(request.website, lp_note_section, 3)"/>
    <section t-if="lp_interviews" class="lp-revista-block lp-revista-home-interviews lp-revista-note-interviews" aria-labelledby="lp-blog-interviews-title">
      <t t-set="lp_interviews_youtube_url" t-value="'https://www.youtube.com/@revistalatinpyme'"/>
      <t t-call="latinpyme_revista_theme.lp_section_heading">
        <t t-set="title">Entrevistas</t>
        <t t-set="eyebrow" t-value="False"/>
        <t t-set="href" t-value="False"/>
        <t t-set="link_label" t-value="False"/>
      </t>
      <div class="lp-revista-interviews-grid lp-revista-interviews-grid--builder lp-revista-interviews-grid--home">
        <aside class="lp-revista-interview-featured">
          <span>Destacado</span>
          <div class="lp-revista-interview-featured__body">
            <a t-att-href="lp_interviews_youtube_url" class="lp-revista-interview-featured__play" aria-label="Ver más entrevistas" target="_blank" rel="noopener">
              <i class="fa fa-play"/>
            </a>
            <p>Explora más entrevistas con líderes que están transformando negocios y comunidades.</p>
          </div>
          <a t-att-href="lp_interviews_youtube_url" class="lp-revista-inline-link" target="_blank" rel="noopener">
            Ver más entrevistas <i class="fa fa-arrow-right"/>
          </a>
        </aside>
        <div class="lp-revista-interviews-grid__cards">
          <t t-foreach="lp_interviews" t-as="interview">
            <t t-call="latinpyme_revista_theme.lp_interview_card">
              <t t-set="interview" t-value="interview"/>
            </t>
          </t>
        </div>
        <aside class="lp-revista-interview-cta lp-revista-interview-cta--join">
          <i class="fa fa-microphone"/>
          <div>
            <h3>¿Quieres ser parte de nuestras entrevistas?</h3>
            <p>Comparte tu experiencia y conecta con nuestra audiencia empresarial.</p>
            <a t-att-href="lp_interviews_youtube_url" class="lp-revista-button" target="_blank" rel="noopener">
              Postúlate aquí <i class="fa fa-arrow-right"/>
            </a>
          </div>
        </aside>
      </div>
    </section>
  </template>
</odoo>
